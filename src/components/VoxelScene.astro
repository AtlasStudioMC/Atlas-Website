---
/**
 * Original isometric voxel artwork used as the hero backdrop.
 *
 * Deliberately NOT built from Minecraft assets: no Mojang textures, screenshots, or trade dress.
 * It's generated geometry in this site's own palette, which reads as "blocky voxel game" without
 * borrowing anything Mojang owns - the same line Paper/Purpur/Leaf hold on their own sites.
 *
 * Drawn as inline SVG rather than a raster/generated image so it stays sharp at any size, costs
 * no extra request, and picks up the exact brand colors instead of approximating them.
 */

// 2:1 isometric projection. W/H describe the top face diamond, D is the cube's vertical side.
const W = 26;
const H = 13;
const D = 21;

type Cube = { gx: number; gy: number; gz: number; tone: "slate" | "amber" | "ember" };

/** Screen position of a cube's top-face apex for grid cell (gx, gy) at stack height gz. */
function project(gx: number, gy: number, gz: number) {
  return {
    x: (gx - gy) * W,
    y: (gx + gy) * H - gz * D,
  };
}

function cubePaths(c: Cube) {
  const { x, y } = project(c.gx, c.gy, c.gz);
  return {
    top: `M ${x} ${y} L ${x + W} ${y + H} L ${x} ${y + 2 * H} L ${x - W} ${y + H} Z`,
    left: `M ${x - W} ${y + H} L ${x} ${y + 2 * H} L ${x} ${y + 2 * H + D} L ${x - W} ${y + H + D} Z`,
    right: `M ${x + W} ${y + H} L ${x} ${y + 2 * H} L ${x} ${y + 2 * H + D} L ${x + W} ${y + H + D} Z`,
    // Depth sort: cells further back (smaller gx+gy) and lower stacks paint first.
    depth: c.gx + c.gy + c.gz * 0.5,
  };
}

// A low terrain plateau. Heights are hand-set rather than random so the render is deterministic
// and the silhouette is intentional instead of noisy.
const heights: Record<string, number> = {
  "0,0": 1, "1,0": 1, "2,0": 2, "3,0": 2,
  "0,1": 1, "1,1": 2, "2,1": 2, "3,1": 1,
  "0,2": 2, "1,2": 2, "2,2": 1, "3,2": 1,
  "0,3": 1, "1,3": 1, "2,3": 1, "3,3": 0,
};

const terrain: Cube[] = [];
for (const [key, stack] of Object.entries(heights)) {
  const [gx, gy] = key.split(",").map(Number);
  for (let gz = 0; gz <= stack; gz++) {
    // Only the top block of each column gets the warm tone, like sunlit ground over dark rock.
    terrain.push({ gx, gy, gz, tone: gz === stack && stack >= 2 ? "amber" : "slate" });
  }
}

// A few blocks hovering above the plateau give the scene motion and carry the accent color.
const floaters: Cube[] = [
  { gx: 3.1, gy: 0.2, gz: 4.4, tone: "ember" },
  { gx: 0.4, gy: 3.2, gz: 3.6, tone: "amber" },
  { gx: 1.8, gy: -0.9, gz: 5.2, tone: "amber" },
];

const all = [...terrain, ...floaters]
  .map((c) => ({ ...c, ...cubePaths(c) }))
  .sort((a, b) => a.depth - b.depth);

const fill = {
  slate: { top: "#232838", left: "#12151d", right: "#1a1e29" },
  amber: { top: "#ffb04d", left: "#a8480a", right: "#d9530a" },
  ember: { top: "#ffc978", left: "#b23e08", right: "#f2740a" },
};
---

<svg
  viewBox="-140 -130 280 260"
  class="h-full w-full"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <!-- Warm pool of light under the plateau so it doesn't sit on a hard edge -->
    <radialGradient id="voxel-ground-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ff8c1a" stop-opacity="0.30" />
      <stop offset="100%" stop-color="#ff8c1a" stop-opacity="0" />
    </radialGradient>
    <!-- Fades the whole scene out toward the edges so it blends into the hero background -->
    <radialGradient id="voxel-vignette" cx="50%" cy="45%" r="62%">
      <stop offset="0%" stop-color="#fff" stop-opacity="1" />
      <stop offset="62%" stop-color="#fff" stop-opacity="0.85" />
      <stop offset="100%" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
    <mask id="voxel-mask">
      <rect x="-140" y="-130" width="280" height="260" fill="url(#voxel-vignette)" />
    </mask>
  </defs>

  <ellipse cx="0" cy="78" rx="128" ry="62" fill="url(#voxel-ground-glow)" />

  <g mask="url(#voxel-mask)">
    {
      all.map((c) => (
        <g class:list={["voxel-cube", c.tone === "slate" ? "" : "voxel-lit"]}>
          <path d={c.left} fill={fill[c.tone].left} />
          <path d={c.right} fill={fill[c.tone].right} />
          <path d={c.top} fill={fill[c.tone].top} />
        </g>
      ))
    }
  </g>
</svg>

<style>
  /* Accent blocks pulse very gently so the scene feels alive without being distracting.
     Staggered via nth-child so they don't beat in unison. */
  .voxel-lit {
    animation: voxel-float 7s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  .voxel-lit:nth-child(3n) {
    animation-delay: -2.4s;
  }
  .voxel-lit:nth-child(3n + 1) {
    animation-delay: -4.8s;
  }

  @keyframes voxel-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .voxel-lit {
      animation: none;
    }
  }
</style>
