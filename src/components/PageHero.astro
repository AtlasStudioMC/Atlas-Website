---
/**
 * Shared header for the inner pages: voxel scene backdrop + eyebrow/title/lead.
 *
 * Centralised so every page gets the identical scrim, spacing and contrast treatment - doing
 * this per-page was how the old markup drifted out of sync.
 *
 * Artwork is original generated voxel scenes, not Minecraft screenshots (no Mojang assets or
 * trade dress), so it stays clean to promote with.
 */
interface Props {
  /** Base name of the scene in /public, e.g. "scene-cave" -> scene-cave.webp + scene-cave-sm.webp */
  scene: string;
  eyebrow: string;
  /** Plain text before the accented word. */
  title: string;
  /** Rendered in the serif accent + gradient. Omit for a single-word plain title. */
  accent?: string;
  /** Plain text after the accent, for titles where the accent sits mid-phrase. */
  titleAfter?: string;
  /** Where to anchor the image crop - lets one asset serve two pages without looking reused. */
  position?: string;
}

const { scene, eyebrow, title, accent, titleAfter, position = "object-center" } = Astro.props;
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <picture>
      <source media="(max-width: 640px)" srcset={`/${scene}-sm.webp`} type="image/webp" />
      <img
        src={`/${scene}.webp`}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class:list={["h-full w-full object-cover", position]}
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-b from-[#080a14]/20 via-[#080a14]/10 to-[#080a14]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_54%_52%_at_50%_45%,rgba(8,10,20,0.36),transparent_82%)]"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-4xl px-6 pt-28 pb-20 text-center lg:pt-32 lg:pb-24">
    <h1 class="mb-4 text-3xl font-semibold sm:text-4xl">
      {title}{accent && <> <span class="text-primary-400">{accent}</span></>}{titleAfter && <> {titleAfter}</>}
    </h1>
    <p class="mx-auto max-w-2xl leading-relaxed text-white/75 [text-shadow:0_1px_12px_rgba(10,11,14,0.9)]">
      <slot />
    </p>
  </div>
</section>
