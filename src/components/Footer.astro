---
const credits = [
  { name: "Leaf", href: "https://github.com/Winds-Studio/Leaf" },
  { name: "Gale", href: "https://github.com/GaleMC/Gale" },
  { name: "Pufferfish", href: "https://github.com/pufferfish-gg/Pufferfish" },
  { name: "Purpur", href: "https://github.com/PurpurMC/Purpur" },
  { name: "KTP", href: "https://github.com/lynxplay/ktp" },
  { name: "Patina", href: "https://github.com/PatinaMC/Patina" },
];
---

<footer class="border-t border-white/5 px-6 py-12 text-sm text-white/50">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 md:flex-row md:items-start md:justify-between">
    <div class="max-w-md">
      <p class="mb-2 font-medium text-white/80">AtlasSpigot</p>
      <p>
        A tuned, rebranded build of <a href="https://github.com/Winds-Studio/Leaf" class="underline hover:text-primary-400">Leaf</a> for
        Minecraft 26.2. Every performance change is checked against upstream source and issue trackers before shipping - see the <a href="https://github.com/AtlasStudioMC/AtlasSpigot" class="underline hover:text-primary-400">GitHub repo</a> for the full writeup.
      </p>
    </div>
    <div>
      <p class="mb-2 font-medium text-white/80">Built on</p>
      <ul class="grid grid-cols-2 gap-x-6 gap-y-1">
        {
          credits.map((c) => (
            <li>
              <a href={c.href} class="hover:text-primary-400">
                {c.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="mb-2 font-medium text-white/80">License</p>
      <p>
        Mixed - MIT and GPL-3.0-only.<br />
        <a href="https://github.com/AtlasStudioMC/AtlasSpigot/blob/main/LICENSE.md" class="underline hover:text-primary-400">
          Full breakdown
        </a>
      </p>
    </div>
  </div>
  <p class="mx-auto mt-8 max-w-6xl border-t border-white/5 pt-6 text-xs text-white/30">
    Not affiliated with Mojang, Microsoft, or PaperMC. Made with <span class="text-primary-500">&#9829;</span> on Earth.
  </p>
</footer>
