---
// Each project's own logo, used to credit and link the upstream work this build stands on.
// KTP has no project mark of its own - the only image on its repo is the maintainer's personal
// photo, which doesn't belong in a credits list - so it renders as text and the layout allows it.
const credits = [
  { name: "Leaf", href: "https://github.com/Winds-Studio/Leaf", logo: "/logos/leaf.webp" },
  { name: "Gale", href: "https://github.com/GaleMC/Gale", logo: "/logos/gale.webp" },
  { name: "Pufferfish", href: "https://github.com/pufferfish-gg/Pufferfish", logo: "/logos/pufferfish.webp" },
  { name: "Purpur", href: "https://github.com/PurpurMC/Purpur", logo: "/logos/purpur.webp" },
  { name: "KTP", href: "https://github.com/lynxplay/ktp" },
  { name: "Patina", href: "https://github.com/PatinaMC/Patina", logo: "/logos/patina.webp" },
];

const columns = [
  {
    title: "Project",
    links: [
      { label: "Downloads", href: "/downloads" },
      { label: "GitHub", href: "https://github.com/AtlasStudioMC/AtlasSpigot" },
      { label: "Docs", href: "/docs" },
    ],
  },
  {
    title: "Performance",
    links: [
      { label: "What's tuned", href: "/tuning" },
      { label: "Benchmarks", href: "/benchmarks" },
      { label: "Roadmap", href: "https://github.com/AtlasStudioMC/AtlasSpigot/blob/main/ROADMAP.md" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "License", href: "https://github.com/AtlasStudioMC/AtlasSpigot/blob/main/LICENSE.md" },
      { label: "bStats", href: "https://bstats.org/plugin/bukkit/AtlasSpigot/33733" },
    ],
  },
];
---

<footer class="border-t border-white/5 px-6 py-14 text-sm text-white/50">
  <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div class="max-w-sm">
      <a href="/" class="mb-2 flex items-center gap-2 font-medium text-white/80">
        <img src="/logo.svg" alt="" width="20" height="20" />
        AtlasSpigot
      </a>
      <p>
        A tuned, rebranded build spanning <a href="https://github.com/PurpurMC/Purpur" class="underline hover:text-primary-400">Purpur</a> and <a href="https://github.com/Winds-Studio/Leaf" class="underline hover:text-primary-400">Leaf</a>. Every performance change is checked against upstream source and issue trackers before shipping.
      </p>
    </div>
    {
      columns.map((col) => (
        <div>
          <p class="mb-3 text-xs font-semibold tracking-wide text-white/40 uppercase">{col.title}</p>
          <ul class="space-y-2">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="hover:text-primary-400">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="mx-auto mt-10 max-w-6xl border-t border-white/5 pt-6">
    <p class="mb-2 text-xs font-semibold tracking-wide text-white/40 uppercase">Built on</p>
    <ul class="flex flex-wrap gap-x-2 gap-y-2">
      {
        credits.map((c) => (
          <li>
            <a
              href={c.href}
              class="flex items-center gap-2 rounded-md border border-white/[0.08] bg-white/[0.02] px-2.5 py-1.5 text-xs text-white/60 transition-colors hover:border-white/20 hover:text-white"
            >
              {c.logo && <img src={c.logo} alt="" width="16" height="16" class="shrink-0" />}
              {c.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="mx-auto mt-8 max-w-6xl border-t border-white/5 pt-6 text-xs text-white/30">
    Not affiliated with Mojang, Microsoft, or PaperMC. Made with <span class="text-primary-500">&#9829;</span> on Earth.
  </p>
</footer>
