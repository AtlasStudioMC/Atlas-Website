---
const links = [
  { href: "/tuning", label: "What's tuned" },
  { href: "https://github.com/AtlasStudioMC/AtlasSpigot", label: "GitHub" },
];
---

<header class="border-b border-white/5 bg-[#05070b]">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6 sm:py-4">
    <a href="/" class="flex shrink-0 items-center gap-2 text-base font-semibold text-white sm:text-lg">
      <img src="/logo.svg" alt="AtlasSpigot" width="28" height="28" class="rounded-lg sm:h-8 sm:w-8" />
      <span>AtlasSpigot</span>
    </a>
    <div class="flex items-center gap-4 text-sm font-medium text-white/70 sm:gap-6">
      {
        links.map((link) => (
          <a href={link.href} class="hidden transition-colors hover:text-primary-400 sm:inline">
            {link.label}
          </a>
        ))
      }
      <a
        href="/downloads"
        class="rounded-lg bg-primary-500 px-3 py-1.5 text-sm font-medium text-black transition-colors hover:bg-primary-400"
      >
        Download
      </a>
    </div>
  </nav>
</header>
