---
const links = [
  { href: "/#products", label: "Products" },
  { href: "/docs", label: "Docs" },
  { href: "/tuning", label: "What's tuned" },
  { href: "/benchmarks", label: "Benchmarks" },
  // The org, not one repo: the studio now ships more than AtlasSpigot.
  { href: "https://github.com/AtlasStudioMC", label: "GitHub" },
];

// Used to mark the current page in the nav. Astro.url.pathname keeps a trailing slash on some
// routes, so compare against a normalized copy.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<header class="sticky top-0 z-50 border-b border-white/[0.07] bg-[#080a14]/80 backdrop-blur-xl">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
    <a
      href="/"
      class="group flex shrink-0 items-center gap-2.5 text-base font-semibold tracking-tight text-white sm:text-lg"
    >
      <img
        src="/logo.svg"
        alt="Atlas Studio"
        width="30"
        height="30"
        class="transition-transform duration-300 group-hover:scale-110 sm:h-9 sm:w-9"
      />
      <span class="leading-none">
        Atlas <span class="text-white/45">Studio</span>
      </span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      {
        links.map((link) => {
          const isActive = link.href.startsWith("/") && !link.href.includes("#") && path === link.href;
          return (
            <a
              href={link.href}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "hidden rounded-lg px-3 py-1.5 text-sm font-medium transition-colors sm:inline-block",
                isActive ? "bg-white/[0.07] text-white" : "text-white/60 hover:bg-white/5 hover:text-white",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      <a
        href="/downloads"
        class="btn-glow ml-1 rounded-lg px-4 py-2 text-sm font-semibold text-black"
      >
        Download
      </a>

      {/* Below sm the links above are hidden, so without this the other pages are unreachable
          from the nav on a phone. <details> keeps it working with no JS. */}
      <details class="nav-mobile relative sm:hidden">
        <summary
          class="ml-1 flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-lg text-white/70 transition-colors hover:bg-white/5 hover:text-white marker:content-none"
          aria-label="Open menu"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </summary>
        <div
          class="absolute right-0 z-50 mt-2 w-56 rounded-xl border border-white/10 bg-[#11152a] p-1.5 shadow-2xl shadow-black/60"
        >
          {
            links.map((link) => (
              <a
                href={link.href}
                class="block rounded-lg px-3 py-2.5 text-sm font-medium text-white/70 transition-colors hover:bg-white/[0.07] hover:text-white"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  /* Hide the default disclosure triangle across browsers */
  .nav-mobile > summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  // Close the mobile menu when clicking outside it or pressing Escape - a <details> menu stays
  // open otherwise, which feels broken after navigating to a hash link on the same page.
  const menu = document.querySelector<HTMLDetailsElement>("details.nav-mobile");
  if (menu) {
    document.addEventListener("click", (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.open) menu.open = false;
    });
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => (menu.open = false)));
  }
</script>
