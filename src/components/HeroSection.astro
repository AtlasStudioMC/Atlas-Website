---
export interface Props {
  title: string;
  subtitle?: string;
  imageUrl?: string;
  cta?: {
    text: string;
    href: string;
    variant?: "primary" | "secondary";
  };
}

const { title, subtitle, imageUrl, cta } = Astro.props;
---

<section class="hero-section">
  <div class="hero-content">
    <h1 class="hero-title">{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    {cta && (
      <a href={cta.href} class={`btn btn-${cta.variant || "primary"}`}>
        {cta.text}
      </a>
    )}
  </div>
  {imageUrl && <img src={imageUrl} alt={title} class="hero-image" />}
</section>

<style>
  .hero-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-4xl);
    align-items: center;
    padding: var(--spacing-4xl) 0;
    margin-bottom: var(--spacing-4xl);
  }

  @media (max-width: 768px) {
    .hero-section {
      grid-template-columns: 1fr;
      gap: var(--spacing-2xl);
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xl);
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    max-width: 80%;
  }

  .hero-image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    object-fit: cover;
    box-shadow: var(--shadow-lg);
  }
</style>
