---
/**
 * A single isometric cube, used as a small identifying mark on cards.
 *
 * Same principle as VoxelScene: original geometry in the site palette, not a Minecraft asset.
 * Kept as its own component so the hero backdrop and these icons stay visually consistent.
 */
interface Props {
  /** "amber" for the active/primary fork, "slate" for secondary. */
  tone?: "amber" | "slate";
  size?: number;
  class?: string;
}

const { tone = "amber", size = 22, class: className = "" } = Astro.props;

const palette = {
  amber: { top: "#ffb04d", left: "#a8480a", right: "#d9530a" },
  slate: { top: "#2c3244", left: "#151922", right: "#1f2431" },
};

// 2:1 isometric cube inside a 0..32 box.
const W = 15;
const H = 7.5;
const D = 13;
const x = 16;
const y = 3;

const top = `M ${x} ${y} L ${x + W} ${y + H} L ${x} ${y + 2 * H} L ${x - W} ${y + H} Z`;
const left = `M ${x - W} ${y + H} L ${x} ${y + 2 * H} L ${x} ${y + 2 * H + D} L ${x - W} ${y + H + D} Z`;
const right = `M ${x + W} ${y + H} L ${x} ${y + 2 * H} L ${x} ${y + 2 * H + D} L ${x + W} ${y + H + D} Z`;
const c = palette[tone];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  class={className}
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <path d={left} fill={c.left} />
  <path d={right} fill={c.right} />
  <path d={top} fill={c.top} />
</svg>
