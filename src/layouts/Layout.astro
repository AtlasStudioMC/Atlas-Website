---
import "@/styles/global.css";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  title: string;
  description: string;
  /** Override only for a page that genuinely duplicates another URL. Normally leave this alone —
   *  the default derives the canonical from the page's own path, which is what you want. */
  canonical?: string;
  /** Visible Q&A on the page. Emitted as FAQPage markup from the same array the page renders,
   *  so the structured data can't drift from what a reader actually sees - which is precisely
   *  what Google penalises. */
  faq?: { q: string; a: string }[];
  /** Keep a page out of the index. For error pages, which shouldn't compete for anything. */
  noindex?: boolean;
}

const { title, description, canonical, faq, noindex = false } = Astro.props;
// Pages whose title already carries the brand are used verbatim, so they can lead with the
// words people actually search for instead of burying them behind a brand nobody queries.
const fullTitle = title.includes("Atlas Studio") ? title : `${title} · Atlas Studio`;

// Absolute URLs, resolved against `site` in astro.config.mjs. Relative canonical/og:image values
// are what search engines and social scrapers handle worst, so everything is absolutised exactly
// once, here. The trailing slash is normalised so /downloads and /downloads/ can't split into two
// competing canonicals.
const path = canonical ?? Astro.url.pathname;
const normalised = path !== "/" && path.endsWith("/") ? path.slice(0, -1) : path;
const canonicalUrl = new URL(normalised, Astro.site).href;
const ogImage = new URL("/og-image.png", Astro.site).href;
const siteUrl = new URL("/", Astro.site).href;

// Google Search Console HTML-tag verification. Committed rather than kept in env because the token
// is public by design - it ships in the page source of every response. The env var still wins, so
// it can be rotated from Vercel without a deploy.
const googleVerification =
  import.meta.env.GOOGLE_SITE_VERIFICATION ?? "fKptqUy_VNDMqSAtCs67_zt1suHAQQQ4cMz4i91D5Oc";

const structuredData: any[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Atlas Studio",
    url: siteUrl,
    description:
      "Free, optimized Minecraft server software: the AtlasSpigot server jar and the AstroVelocity proxy.",
    publisher: { "@id": siteUrl + "#org" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": siteUrl + "#org",
    name: "Atlas Studio",
    url: siteUrl,
    logo: new URL("/favicon-192.png", Astro.site).href,
    sameAs: ["https://github.com/AtlasStudioMC"],
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "AstroVelocity",
    applicationCategory: "GameApplication",
    operatingSystem: "Windows, macOS, Linux",
    url: siteUrl,
    downloadUrl: "https://github.com/AtlasStudioMC/AstroVelocity/releases",
    license: "https://www.gnu.org/licenses/gpl-3.0.html",
    description:
      "A free Minecraft proxy built on Velocity-CTD. Sits in front of your servers and moves players between them, keeping every Velocity plugin working.",
    author: { "@id": siteUrl + "#org" },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "AtlasSpigot",
    applicationCategory: "GameApplication",
    operatingSystem: "Windows, macOS, Linux",
    url: siteUrl,
    downloadUrl: siteUrl + "downloads",
    license: "https://www.gnu.org/licenses/gpl-3.0.html",
    description:
      "A free, drop-in Minecraft server jar that runs faster than stock Paper and works with your Paper and Spigot plugins. Supports Minecraft 1.20 through 26.2.",
    author: { "@id": siteUrl + "#org" },
    // Deliberately no offers/aggregateRating: it's free and has no real review data, and inventing
    // either is exactly the structured-data abuse Google issues manual actions for.
  },
];

if (faq?.length) {
  structuredData.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  } as any);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#080a14" />

    <meta property="og:site_name" content="AtlasSpigot" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AtlasSpigot" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

  </body>
</html>
