---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import { VERSIONS, FORK_INFO, type Fork } from "@/data/versions";

export const prerender = false;

interface GhAsset {
  name: string;
  size: number;
  browser_download_url: string;
  download_count: number;
}

interface GhRelease {
  tag_name: string;
  name: string;
  published_at: string;
  html_url: string;
  assets: GhAsset[];
}

let releases: GhRelease[] = [];
let fetchFailed = false;

try {
  const res = await fetch("https://api.github.com/repos/AtlasStudioMC/AtlasSpigot/releases?per_page=100", {
    headers: { Accept: "application/vnd.github+json" },
  });
  if (res.ok) {
    releases = await res.json();
    releases.sort((a, b) => new Date(b.published_at).getTime() - new Date(a.published_at).getTime());
  } else {
    fetchFailed = true;
  }
} catch {
  fetchFailed = true;
}

// Tags look like "atlasspigot-<mc-version>-<n>", except the very first release ever
// ("atlasspigot-26.2", no trailing number) - the trailing "-<n>" is optional here so that
// one still groups under "26.2" instead of becoming its own bogus version group.
function versionOf(tagName: string): string {
  const match = tagName.match(/^atlasspigot-(.+?)(?:-\d+)?$/);
  return match ? match[1] : tagName;
}

function forkOf(version: string): Fork | null {
  return VERSIONS.find((v) => v.version === version)?.fork ?? null;
}

const VERSION_ORDER = VERSIONS.map((v) => v.version);

const groups = new Map<string, GhRelease[]>();
for (const rel of releases) {
  const v = versionOf(rel.tag_name);
  if (!groups.has(v)) groups.set(v, []);
  groups.get(v)!.push(rel);
}

const orderedVersions = [...groups.keys()].sort((a, b) => {
  const ai = VERSION_ORDER.indexOf(a);
  const bi = VERSION_ORDER.indexOf(b);
  if (ai === -1 && bi === -1) return a.localeCompare(b);
  if (ai === -1) return 1;
  if (bi === -1) return -1;
  return ai - bi;
});

const releasedVersionNames = new Set(orderedVersions);
const plannedByFork = new Map<Fork, string[]>();
for (const v of VERSIONS) {
  if (v.status === "planned" && !releasedVersionNames.has(v.version)) {
    if (!plannedByFork.has(v.fork)) plannedByFork.set(v.fork, []);
    plannedByFork.get(v.fork)!.push(v.version);
  }
}

function formatSize(bytes: number) {
  // The config bundle is tens of KB - formatting everything as MB rendered it as "0.0 MB".
  if (bytes < 1024 * 1024) return `${Math.round(bytes / 1024)} KB`;
  return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
}

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}

// Releases can carry more than just the server jar (e.g. a config bundle). GitHub returns assets
// alphabetically, so "AtlasSpigot-<v>-config.zip" sorts ahead of "AtlasSpigot-<v>.jar" - taking
// assets[0] would hand people the config zip when they clicked Download. Always prefer the jar.
function primaryAsset(assets: GhAsset[]): GhAsset | undefined {
  return assets.find((a) => a.name.endsWith(".jar")) ?? assets[0];
}

// List the server jar first for the same reason - it's what most people came for.
function orderedAssets(assets: GhAsset[]): GhAsset[] {
  return [...assets].sort((a, b) => Number(b.name.endsWith(".jar")) - Number(a.name.endsWith(".jar")));
}
---

<Layout title="Download Minecraft Server Jar (1.20 – 26.2)" description="Free AtlasSpigot server jar downloads for Minecraft 1.20 through 26.2. Optimized builds of Leaf and Purpur that stay compatible with all your Paper plugins.">
  <PageHero scene="scene-sunset" eyebrow="Releases" title="" accent="Downloads" position="object-center">
    Pick your Minecraft version and download the file. The newest one is always at the top.
  </PageHero>

  {
    fetchFailed || releases.length === 0 ? (
      <section class="mx-auto max-w-3xl px-6 pb-24">
        <div class="surface p-8 text-left">
          <p class="mb-4 text-white/70">
            Couldn't load release data directly from GitHub right now. Grab the jar from the Releases page instead:
          </p>
          <a
            href="https://github.com/AtlasStudioMC/AtlasSpigot/releases"
            class="btn-glow inline-block rounded-xl px-6 py-3 font-semibold text-black"
          >
            View Releases on GitHub
          </a>
        </div>
      </section>
    ) : (
      orderedVersions.map((version) => {
        const [latest, ...older] = groups.get(version)!;
        const fork = forkOf(version);
        return (
          <section class="mx-auto max-w-3xl px-6 pb-16">
            <div class="mb-4 flex flex-wrap items-baseline gap-3">
              <h2 class="text-2xl font-medium">
                Minecraft <span class="text-primary-400">{version}</span>
              </h2>
              {fork && (
                <a href={FORK_INFO[fork].href} class="shrink-0 rounded-full bg-white/10 px-2.5 py-0.5 text-xs whitespace-nowrap text-white/60 hover:text-white">
                  built on {fork}
                </a>
              )}
            </div>

            <div class="surface surface-hover p-8 text-left">
              <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
                <div>
                  <p class="text-xs font-medium tracking-wide text-primary-400 uppercase">Latest</p>
                  <h3 class="text-xl font-medium">{latest.name || latest.tag_name}</h3>
                  <p class="text-xs text-white/40">{formatDate(latest.published_at)}</p>
                </div>
                <a href={latest.html_url} class="text-sm text-primary-400 underline">
                  Release notes
                </a>
              </div>
              {latest.assets.length > 0 ? (
                <ul class="flex flex-col gap-3">
                  {orderedAssets(latest.assets).map((asset) => (
                    <li class="flex flex-wrap items-center justify-between gap-3 rounded-xl bg-black/40 px-4 py-3 ring-1 ring-white/[0.06]">
                      <div>
                        <p class="font-mono text-sm">{asset.name}</p>
                        <p class="text-xs text-white/40">
                          {formatSize(asset.size)} · {asset.download_count} downloads
                        </p>
                      </div>
                      <a
                        href={asset.browser_download_url}
                        class="btn-glow rounded-lg px-4 py-2 text-sm font-semibold text-black"
                      >
                        Download
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="text-sm text-white/50">This release has no attached files.</p>
              )}
            </div>

            {older.length > 0 && (
              <details class="surface mt-4 p-6 text-left">
                <summary class="cursor-pointer text-sm font-medium text-white/60">
                  {older.length} previous release{older.length === 1 ? "" : "s"} for {version}
                </summary>
                <ul class="mt-4 flex flex-col divide-y divide-white/5">
                  {older.map((rel) => (
                    <li class="flex flex-wrap items-center justify-between gap-3 py-3 first:pt-0 last:pb-0">
                      <div>
                        <p class="text-sm font-medium">{rel.name || rel.tag_name}</p>
                        <p class="text-xs text-white/40">{formatDate(rel.published_at)}</p>
                      </div>
                      <div class="flex items-center gap-3">
                        <a href={rel.html_url} class="text-sm text-primary-400 underline">
                          Notes
                        </a>
                        {primaryAsset(rel.assets) && (
                          <a
                            href={primaryAsset(rel.assets)!.browser_download_url}
                            class="rounded-lg border border-white/15 px-3 py-1.5 text-sm font-medium hover:border-white/30"
                          >
                            Download
                          </a>
                        )}
                      </div>
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </section>
        );
      })
    )
  }

  {
    plannedByFork.size > 0 && (
      <section class="mx-auto max-w-3xl px-6 pb-16">
        <h2 class="mb-2 text-2xl font-medium">On the roadmap</h2>
        <p class="mb-6 text-sm text-white/50">Not released yet - listed here so the plan is honest, not just the finished part.</p>
        <div class="flex flex-col gap-4">
          {[...plannedByFork.entries()].map(([fork, versions]) => (
            <div class="surface p-6 text-left">
              <div class="mb-3 flex items-center gap-2">
                <h3 class="font-medium">{fork}</h3>
                <a href={FORK_INFO[fork].href} class="text-xs text-primary-400 underline">
                  upstream
                </a>
              </div>
              <ul class="flex flex-wrap gap-2">
                {versions.map((v) => (
                  <li class="rounded-md bg-white/5 px-2 py-1 font-mono text-xs text-white/40">{v}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-3xl px-6 pb-24">
    <div class="surface p-8 text-left">
      <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2">
        <h2 class="text-lg font-medium text-white/90">Running more than one server?</h2>
        <span class="pill pill-on">build-1</span>
      </div>
      <p class="mb-5 text-sm leading-relaxed text-white/60">
        AstroVelocity is a proxy. It goes in front of your servers and moves players between them, so a lobby
        and a survival world feel like one place. Every Velocity plugin still works. Skip this if you only run one server.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href="https://github.com/AtlasStudioMC/AstroVelocity/releases/download/build-1/AstroVelocity-b1.jar"
          class="btn-primary px-5 py-2.5 text-sm"
        >
          Download AstroVelocity
        </a>
        <a href="https://github.com/AtlasStudioMC/AstroVelocity" class="text-sm text-white/45 underline decoration-white/20 underline-offset-4 hover:text-primary-400">
          Source and setup ↗
        </a>
        <span class="text-sm text-white/35">Needs Java 25.</span>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-24">
    <div class="surface p-8 text-left text-sm text-white/60">
      <h2 class="mb-3 font-medium text-white/80">Setting it up</h2>
      <ol class="list-decimal space-y-2 pl-5">
        <li>Copy everything else for your Minecraft version from the repo into the same folder as the jar: <code>start.sh</code>, <code>server.properties</code>, <code>spigot.yml</code>, <code>eula.txt</code>, and the whole <code>config/</code> directory. Each non-root version lives in its own folder in the repo (e.g. <code>1.21.11/</code>).</li>
        <li>Open <code>eula.txt</code> and set <code>eula=true</code>.</li>
        <li>Run <code>./start.sh</code> (or <code>java -jar &lt;the jar&gt;.jar nogui</code> directly).</li>
      </ol>
      <p class="mt-4">
        Branding shows correctly with just the jar, but performance tuning needs the config files too - see the <a href="https://github.com/AtlasStudioMC/AtlasSpigot#quick-start" class="text-primary-400 underline">full quick start guide</a> for hosting-panel notes and details.
      </p>
    </div>
  </section>
</Layout>
