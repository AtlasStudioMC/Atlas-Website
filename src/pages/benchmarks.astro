---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";

const env = [
  { label: "Version", value: "1.21.4" },
  { label: "CPU", value: "Apple M3 Pro" },
  { label: "JVM", value: "OpenJDK 21.0.10" },
  { label: "Memory", value: "4GB heap" },
  { label: "AtlasSpigot Commit", value: "2d6d1f2" },
  { label: "Paper Build", value: "1.21.4 #232 (12d8fe0)" },
  { label: "Seed", value: "2618050634530417871" },
  { label: "Coords", value: "183 67 -201" },
];

const jvmFlags =
  "-Xms4G -Xmx4G -XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M -XX:G1ReservePercent=20 -XX:G1HeapWastePercent=5 -XX:G1MixedGCCountTarget=4 -XX:InitiatingHeapOccupancyPercent=15 -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1RSetUpdatingPauseTimePercent=5 -XX:SurvivorRatio=32 -XX:MaxTenuringThreshold=1";

const scenarios = [
  {
    name: "Baseline (300 entities)",
    bars: [
      { label: "AtlasSpigot", value: 4.8745, highlight: true },
      { label: "Paper (vanilla)", value: 6.735, highlight: false },
    ],
  },
  {
    name: "Increased load (1,000 entities)",
    bars: [
      { label: "AtlasSpigot", value: 8.1114, highlight: true },
      { label: "Paper (vanilla)", value: 25.7943, highlight: false },
    ],
  },
];

const maxValue = Math.max(...scenarios.flatMap((s) => s.bars.map((b) => b.value)));

const chunkGen = {
  chunks: 10201,
  radius: 50,
  bars: [
    { label: "AtlasSpigot", seconds: 121.868, highlight: true },
    { label: "Paper (vanilla)", seconds: 134.805, highlight: false },
  ],
};

function fmtTime(totalSeconds: number) {
  const m = Math.floor(totalSeconds / 60);
  const s = Math.round(totalSeconds - m * 60);
  return `${m}:${s.toString().padStart(2, "0")}`;
}

const chunkGenMax = Math.max(...chunkGen.bars.map((b) => b.seconds));
const chunkGenImprovementPct = Math.round(
  ((chunkGen.bars[1].seconds - chunkGen.bars[0].seconds) / chunkGen.bars[1].seconds) * 100 * 10
) / 10;
// Static content, so it ships as a prerendered file served straight from the CDN edge
// rather than booting a serverless function per request. Only /downloads needs SSR (it
// reads the GitHub releases API at request time).
export const prerender = true;
---

<Layout
  title="Benchmarks: AtlasSpigot vs Paper MSPT"
  description="Real measured Minecraft server benchmarks — tick time (MSPT) and chunk generation, AtlasSpigot against stock Paper. Full hardware, JVM flags and raw results."
>
  <PageHero scene="scene-cave" eyebrow="Benchmarks" title="Entity" accent="performance" position="object-center">
    We ran AtlasSpigot and normal Paper on the same computer, same world, same settings, and timed both. Lower numbers are better. This was one test on one machine, so your results may differ — <a href="#methodology" class="text-primary-300 underline underline-offset-4">here's exactly how we did it</a>.
  </PageHero>

  <section class="mx-auto max-w-3xl px-6 pb-16">
    <h2 class="mb-4 text-sm font-medium text-white/50">Test environment</h2>
    <div class="surface grid grid-cols-2 overflow-hidden sm:grid-cols-4">
      {
        env.map((e, i) => (
          <div
            class:list={[
              "px-4 py-4",
              i % 2 === 0 ? "border-r border-white/[0.06]" : "",
              "sm:border-r sm:border-white/[0.06] sm:last:border-r-0",
              i < env.length - 2 ? "border-b border-white/[0.06]" : "",
            ]}
          >
            <div class="text-[11px] tracking-wide text-white/35 uppercase">{e.label}</div>
            <div class="mt-1.5 font-mono text-sm break-all text-white/85">{e.value}</div>
          </div>
        ))
      }
    </div>
    <details class="surface group mt-4 p-5">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium text-white/70 marker:content-none">
        <span>JVM flags (identical on both servers)</span>
        <span class="shrink-0 text-lg leading-none text-primary-400 transition-transform duration-200 group-open:rotate-45">+</span>
      </summary>
      <pre class="mt-4 overflow-x-auto rounded-lg bg-black/50 p-4 font-mono text-xs leading-relaxed text-white/55">{jvmFlags}</pre>
    </details>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-20">
    <h2 class="mb-6 text-sm font-medium text-white/50">Performance comparison — MSPT, lower is better</h2>
    <div class="space-y-9">
      {
        scenarios.map((scenario) => (
          <div class="surface p-7">
            <h3 class="mb-5 text-base font-semibold text-white">{scenario.name}</h3>
            <div class="space-y-5">
              {scenario.bars.map((bar, bi) => (
                <div>
                  <div class="mb-2 flex items-baseline justify-between gap-4">
                    <span class:list={["text-sm", bar.highlight ? "font-medium text-white" : "text-white/55"]}>
                      {bar.label}
                    </span>
                    <span
                      class:list={[
                        "font-mono text-sm tabular-nums",
                        bar.highlight ? "text-primary-300" : "text-white/45",
                      ]}
                    >
                      {bar.value.toFixed(2)} <span class="text-xs text-white/30">mspt</span>
                    </span>
                  </div>
                  <div class="h-2.5 w-full overflow-hidden rounded-full bg-white/[0.04]">
                    <div
                      class:list={[
                        "bar-fill h-full rounded-full",
                        bar.highlight
                          ? "bg-gradient-to-r from-primary-600 via-primary-500 to-primary-300"
                          : "bg-white/20",
                      ]}
                      style={`width: ${(bar.value / maxValue) * 100}%; animation-delay: ${bi * 120}ms`}
                    />
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-20">
    <div class="mb-10 text-center">
      <h2 class="mb-4 text-4xl font-semibold lg:text-5xl">
        Chunk generation <span class="text-primary-400">time</span>
      </h2>
      <p class="mx-auto max-w-2xl leading-relaxed text-white/55">
        Wall-clock time to fully generate a fixed {chunkGen.radius * 2 + 1}×{chunkGen.radius * 2 + 1} chunk region
        ({chunkGen.chunks.toLocaleString()} chunks) from the same seed, single run each. Lower is better.
      </p>
    </div>
    <div class="surface p-7">
      <h3 class="mb-5 text-base font-semibold text-white">World generation</h3>
      <div class="space-y-5">
        {
          chunkGen.bars.map((bar, bi) => (
            <div>
              <div class="mb-2 flex items-baseline justify-between gap-4">
                <span class:list={["text-sm", bar.highlight ? "font-medium text-white" : "text-white/55"]}>
                  {bar.label}
                </span>
                <span
                  class:list={[
                    "font-mono text-sm tabular-nums",
                    bar.highlight ? "text-primary-300" : "text-white/45",
                  ]}
                >
                  {fmtTime(bar.seconds)}
                </span>
              </div>
              <div class="h-2.5 w-full overflow-hidden rounded-full bg-white/[0.04]">
                <div
                  class:list={[
                    "bar-fill h-full rounded-full",
                    bar.highlight ? "bg-gradient-to-r from-primary-600 via-primary-500 to-primary-300" : "bg-white/20",
                  ]}
                  style={`width: ${(bar.seconds / chunkGenMax) * 100}%; animation-delay: ${bi * 120}ms`}
                />
              </div>
            </div>
          ))
        }
      </div>
      <div class="mt-7 border-t border-white/[0.07] pt-6 text-center">
        <div class="text-[11px] tracking-[0.16em] text-white/35 uppercase">Performance improvement</div>
        <div class="mt-2 text-5xl font-semibold text-primary-400">{chunkGenImprovementPct}%</div>
        <div class="mt-1.5 text-xs text-white/45">faster than stock Paper, this specific run</div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-20">
    <h2 class="mb-4 text-sm font-medium text-white/50">What happened when we tested 26.2</h2>
    <div class="surface p-8 text-sm leading-relaxed text-white/65">
      <p class="mb-4">
        Everything above is from Minecraft 1.21.4. We also ran the same test on 26.2, our newest and most heavily
        tuned build, and <span class="text-white">the result was too noisy to publish a number from</span>. We are
        putting it here anyway, because a benchmark page that only shows the flattering runs is not worth reading.
      </p>
      <p class="mb-4">
        Eight runs, alternating between AtlasSpigot and stock Paper so the machine warming up would affect both
        equally. AtlasSpigot averaged <span class="font-mono text-white">10.94</span> ms per tick against Paper's
        <span class="font-mono text-white">13.15</span> — about 17% ahead. But the runs varied so much that the
        gap does not mean anything: Paper's own results ranged from 8.89 to 17.95, ours from 5.03 to 14.50, and
        one of the four matched pairs came out in Paper's favour.
      </p>
      <p class="mb-4">
        The reason is the test machine, not the software. It is a laptop, and across eight back-to-back
        4GB servers it heated up and slowed down: the last Paper run was 76% slower than the first, purely because
        it ran later. An earlier batch produced the opposite ordering entirely.
      </p>
      <p>
        So: 26.2 is genuinely unmeasured, and we would rather say that than dress up a number the data does not
        support. Doing it properly needs a machine with a stable clock. The full raw output and analysis is in
        <a href="https://github.com/AtlasStudioMC/AtlasSpigot/blob/main/benchmarks/results-26.2.txt" class="text-primary-400 underline">results-26.2.txt</a>.
      </p>
    </div>
  </section>

  <section id="methodology" class="mx-auto max-w-3xl px-6 pb-24">
    <h2 class="mb-4 text-xl font-medium text-white/80">Methodology</h2>
    <p class="text-white/70">
      Both servers ran a small measurement plugin (<a href="https://github.com/AtlasStudioMC/AtlasSpigot" class="text-primary-400 underline">source in the repo</a>)
      that, after full startup, force-loads a fixed 21×21 chunk region around the test coordinates, spawns a fixed,
      seeded set of entities (a mix of zombies, skeletons, spiders, cows, and sheep — same seed, same positions on
      both runs), waits a warmup period for chunk generation and pathfinding to settle, then samples real MSPT via
      Paper's <code>ServerTickEndEvent</code> for 400 consecutive ticks (20 seconds) and writes the average. AtlasSpigot
      ran with its own documented tuned config (<a href="/tuning" class="text-primary-400 underline">see What's tuned</a>);
      Paper ran with its untouched defaults — this reflects what each project's config actually ships, not an
      artificially equalized config.
    </p>
    <p class="mt-3 text-white/70">
      The chunk generation test uses a second, similarly small plugin: after startup it force-generates a fixed
      101×101 chunk square around the same coordinates via <code>World#getChunkAtAsync(x, z, true)</code>, timing
      wall-clock elapsed time from the first request to the last chunk completing. Same seed, same JVM flags, one
      run each, no players connected — a clean, repeatable measure of raw generation throughput rather than steady-state
      tick cost.
    </p>
    <p class="mt-3 text-white/70">
      No numbers here are estimated, extrapolated, or copied from another project's own benchmark page. Every value
      above came from an actual run on this machine on the date this page was last updated. Re-running it yourself
      (same seed, same JVM flags, same plugins) should land close to these numbers on comparable hardware — meaningfully
      different results are worth reporting as an issue.
    </p>
  </section>
</Layout>
