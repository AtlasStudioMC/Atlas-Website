---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import { builds, optimizationLayers, performanceComparison } from "@/data/builds";

export const prerender = true;
---

<Layout
  title="Aurora, Atlas & Astro - Optimized Minecraft Server Software"
  description="High-performance Minecraft servers: Aurora (regionised Folia), Atlas (Paper fork), Astro (Velocity proxy). Ultra-optimized with 64 patches, -35-50ms ping, +35-50% throughput."
  breadcrumbs={[{ name: "Builds", path: "/builds" }]}
>
  <PageHero scene="scene-aurora" eyebrow="Builds" title="" accent="Optimized">
    Three server products, each optimized for different needs. All built on proven foundations, all heavily tuned.
  </PageHero>

  <!-- Product Overview -->
  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-8 md:grid-cols-3">
      {builds.map((build) => (
        <div class="surface rounded-2xl p-8 text-left">
          <div class="mb-4">
            <h2 class="text-2xl font-bold text-primary-400">{build.name}</h2>
            <p class="text-sm text-white/60">v{build.version}</p>
          </div>

          <div class="mb-4 inline-block rounded-full bg-primary-500/10 px-3 py-1 text-xs font-medium text-primary-300">
            {build.patches > 0 ? `${build.patches} Patches` : 'Latest'}
          </div>

          <p class="mb-6 text-sm leading-relaxed text-white/70">{build.size} • {build.type}</p>

          <div class="mb-8 space-y-2 text-sm">
            {build.features.slice(0, 4).map((feature) => (
              <div class="flex items-start gap-2">
                <span class="mt-1 text-primary-400">✓</span>
                <span class="text-white/70">{feature}</span>
              </div>
            ))}
          </div>

          {Object.keys(build.performanceGains).length > 0 && (
            <div class="mb-6 border-t border-white/10 pt-4">
              <p class="mb-2 text-xs font-medium text-white/50 uppercase">Performance Gains</p>
              <div class="space-y-1 text-sm">
                {build.performanceGains.ping && (
                  <p><span class="text-primary-400">Ping:</span> {build.performanceGains.ping}</p>
                )}
                {build.performanceGains.throughput && (
                  <p><span class="text-primary-400">Throughput:</span> {build.performanceGains.throughput}</p>
                )}
                {build.performanceGains.cpu && (
                  <p><span class="text-primary-400">CPU:</span> {build.performanceGains.cpu}</p>
                )}
              </div>
            </div>
          )}

          <a
            href={build.downloadUrl}
            class="btn-primary block w-full rounded-lg py-2.5 text-center font-semibold"
          >
            Download {build.name}
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- Performance Comparison Table -->
  <section class="mx-auto max-w-4xl px-6 py-16">
    <h2 class="mb-8 text-3xl font-bold">Aurora Performance Metrics</h2>

    <div class="surface overflow-x-auto rounded-2xl p-8">
      <table class="w-full">
        <thead>
          <tr class="border-b border-white/10">
            <th class="pb-3 text-left text-sm font-semibold text-white/60">Metric</th>
            <th class="pb-3 text-left text-sm font-semibold text-white/60">Before</th>
            <th class="pb-3 text-left text-sm font-semibold text-white/60">After</th>
            <th class="pb-3 text-left text-sm font-semibold text-primary-400">Improvement</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          {performanceComparison.map((row) => (
            <tr class="hover:bg-white/[0.03]">
              <td class="py-3 text-sm font-medium text-white/90">{row.metric}</td>
              <td class="py-3 text-sm text-white/70">{row.before}</td>
              <td class="py-3 text-sm text-white/70">{row.after}</td>
              <td class="py-3 text-sm font-semibold text-primary-400">{row.improvement}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Optimization Layers -->
  <section class="mx-auto max-w-6xl px-6 py-16">
    <h2 class="mb-8 text-3xl font-bold">64-Patch Optimization Suite (Aurora)</h2>
    <p class="mb-12 text-white/70">Aurora includes comprehensive optimizations across six layers:</p>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {Object.values(optimizationLayers).map((layer) => (
        <div class="surface rounded-xl p-6 text-left">
          <div class="mb-3 flex items-center gap-2">
            <span class="rounded-full bg-primary-500/20 px-2 py-1 text-xs font-semibold text-primary-400">
              {layer.patches}
            </span>
            <h3 class="font-semibold text-white/90">{layer.name}</h3>
          </div>
          <p class="text-sm leading-relaxed text-white/60">{layer.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Key Features -->
  <section class="mx-auto max-w-4xl px-6 py-16">
    <h2 class="mb-8 text-3xl font-bold">Why Choose Aurora?</h2>

    <div class="grid gap-6 md:grid-cols-2">
      <div class="surface rounded-xl p-6 text-left">
        <h3 class="mb-3 text-lg font-semibold">Extreme Performance</h3>
        <ul class="space-y-2 text-sm text-white/70">
          <li>✓ 35-50ms ping reduction</li>
          <li>✓ 35-50% throughput increase</li>
          <li>✓ 20-25% CPU reduction</li>
          <li>✓ 15-20% memory reduction</li>
        </ul>
      </div>

      <div class="surface rounded-xl p-6 text-left">
        <h3 class="mb-3 text-lg font-semibold">Multi-threaded</h3>
        <ul class="space-y-2 text-sm text-white/70">
          <li>✓ Region threading via Folia</li>
          <li>✓ Per-region processing</li>
          <li>✓ Multi-core utilization</li>
          <li>✓ No single-thread bottleneck</li>
        </ul>
      </div>

      <div class="surface rounded-xl p-6 text-left">
        <h3 class="mb-3 text-lg font-semibold">Crash Prevention</h3>
        <ul class="space-y-2 text-sm text-white/70">
          <li>✓ 40+ null pointer scenarios</li>
          <li>✓ Deadlock prevention</li>
          <li>✓ Memory leak detection</li>
          <li>✓ Error recovery mechanisms</li>
        </ul>
      </div>

      <div class="surface rounded-xl p-6 text-left">
        <h3 class="mb-3 text-lg font-semibold">Advanced Optimization</h3>
        <ul class="space-y-2 text-sm text-white/70">
          <li>✓ Packet prioritization</li>
          <li>✓ Dynamic bandwidth throttling</li>
          <li>✓ Object pooling (40% GC ↓)</li>
          <li>✓ Adaptive TPS management</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Recommended Configuration -->
  <section class="mx-auto max-w-4xl px-6 py-16">
    <h2 class="mb-8 text-3xl font-bold">Recommended Configuration</h2>

    <div class="space-y-6">
      <div class="surface rounded-xl p-6 text-left">
        <h3 class="mb-4 font-semibold">JVM Flags</h3>
        <code class="block rounded-lg bg-black/50 p-4 font-mono text-sm text-primary-400">
java -Xmx6G -Xms6G \<br/>
&nbsp;&nbsp;-XX:+UseG1GC \<br/>
&nbsp;&nbsp;-XX:MaxGCPauseMillis=45 \<br/>
&nbsp;&nbsp;-XX:InitiatingHeapOccupancyPercent=25 \<br/>
&nbsp;&nbsp;-Daurora.ping.optimization=true \<br/>
&nbsp;&nbsp;-jar aurora.jar nogui
        </code>
      </div>

      <div class="surface rounded-xl p-6 text-left">
        <h3 class="mb-4 font-semibold">server.properties</h3>
        <code class="block rounded-lg bg-black/50 p-4 font-mono text-sm text-primary-400">
network-compression-threshold=256<br/>
view-distance=10<br/>
simulation-distance=8<br/>
max-players=100
        </code>
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="mx-auto max-w-4xl px-6 py-16">
    <h2 class="mb-8 text-3xl font-bold">Product Comparison</h2>

    <div class="surface overflow-x-auto rounded-2xl p-8">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b border-white/10">
            <th class="pb-3 font-semibold text-white/60">Feature</th>
            <th class="pb-3 font-semibold text-white/60">Aurora</th>
            <th class="pb-3 font-semibold text-white/60">Atlas</th>
            <th class="pb-3 font-semibold text-white/60">Astro</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          <tr>
            <td class="py-3 font-medium">Type</td>
            <td class="py-3">Regionised Server</td>
            <td class="py-3">Paper Fork</td>
            <td class="py-3">Velocity Proxy</td>
          </tr>
          <tr>
            <td class="py-3 font-medium">Multi-threaded</td>
            <td class="py-3 text-green-400">✓</td>
            <td class="py-3 text-white/50">—</td>
            <td class="py-3 text-green-400">✓</td>
          </tr>
          <tr>
            <td class="py-3 font-medium">Optimization Patches</td>
            <td class="py-3">64</td>
            <td class="py-3">38</td>
            <td class="py-3">0</td>
          </tr>
          <tr>
            <td class="py-3 font-medium">Plugin Compatible</td>
            <td class="py-3 text-yellow-400">Limited*</td>
            <td class="py-3 text-green-400">✓</td>
            <td class="py-3 text-green-400">✓</td>
          </tr>
          <tr>
            <td class="py-3 font-medium">Best For</td>
            <td class="py-3">Maximum performance</td>
            <td class="py-3">Balance of speed & compatibility</td>
            <td class="py-3">Multi-server proxy</td>
          </tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-white/50">* Aurora requires plugins to declare folia-supported or canvas-supported in plugin.yml</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-4xl px-6 py-16 text-center">
    <h2 class="mb-4 text-3xl font-bold">Ready to get started?</h2>
    <p class="mb-8 text-white/70">Download Aurora, Atlas, or Astro and experience ultra-optimized Minecraft server performance.</p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/downloads" class="btn-glow rounded-lg px-6 py-3 font-semibold text-black">
        Download Now
      </a>
      <a href="https://github.com/AtlasStudioMC/Aurora" class="btn-secondary rounded-lg px-6 py-3 font-semibold">
        View on GitHub
      </a>
    </div>
  </section>
</Layout>
