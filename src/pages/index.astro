---
import Layout from "@/layouts/Layout.astro";
import HeroSection from "@/components/HeroSection.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import ImageGallery from "@/components/ImageGallery.astro";

const minecraftImages = [
  {
    src: "https://images.unsplash.com/photo-1524685794168-52985e79c1f8?w=500&h=400&fit=crop",
    alt: "Minecraft Steve character figure",
    caption: "Iconic characters"
  },
  {
    src: "https://images.unsplash.com/photo-1759663174699-d0e64ed0fb66?w=500&h=400&fit=crop",
    alt: "Minecraft zombie mobs figures",
    caption: "Survive the night"
  },
  {
    src: "https://images.unsplash.com/photo-1589609966838-5c628d5c1aa5?w=500&h=400&fit=crop",
    alt: "Minecraft Earth mobile game on a phone screen",
    caption: "Play anywhere"
  },
  {
    src: "https://images.unsplash.com/photo-1587573089734-09cb69c0f2b4?w=500&h=400&fit=crop",
    alt: "Minecraft official website open on a laptop",
    caption: "Join the community"
  }
];

const features = [
  {
    title: "We test everything",
    description: "Before we turn a setting on, we check it properly. If it could break your world, we leave it off.",
    icon: "✓"
  },
  {
    title: "Your plugins still work",
    description: "Anything made for Paper, Purpur or Spigot runs here. One setting in the tuned config switches off hopper events for speed.",
    icon: "🔌"
  },
  {
    title: "Old versions too",
    description: "16 versions, from 1.20 all the way to 26.2. Every one gets the same care.",
    icon: "📦"
  }
];
---

<Layout title="Atlas Studio - Premium Minecraft Server Software" description="High-performance Minecraft server software with careful tuning, extensive testing, and plugin compatibility.">
  <div class="container">
    <!-- Hero Section -->
    <HeroSection
      title="Experience Minecraft Like Never Before"
      subtitle="Atlas Studio delivers carefully tested, high-performance server software built on Paper and Leaf. Optimized for speed, stability, and your plugins."
      imageUrl="https://images.unsplash.com/photo-1772080543578-2b8322bdcf4e?w=800&h=600&fit=crop"
      cta={{
        text: "Download Now",
        href: "/downloads",
        variant: "primary"
      }}
    />

    <!-- Features Grid -->
    <section class="features-section">
      <h2 class="section-title">Why Atlas Studio</h2>
      <div class="features-grid">
        {features.map((feature) => (
          <FeatureCard
            title={feature.title}
            description={feature.description}
            icon={feature.icon}
          />
        ))}
      </div>
    </section>

    <!-- Image Gallery -->
    <ImageGallery
      title="The Minecraft Experience"
      images={minecraftImages}
    />

    <!-- Call to Action Section -->
    <section class="cta-section">
      <div class="cta-content">
        <h2>Ready to enhance your server?</h2>
        <p>Choose from Aurora (region-threaded), Atlas (Paper-based), or Astro (proxy). All with careful testing and extensive documentation.</p>
        <div class="cta-buttons">
          <a href="/downloads" class="btn btn-primary">Get Started</a>
          <a href="/docs" class="btn btn-secondary">Read Documentation</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--spacing-2xl);
  }

  .features-section {
    padding: var(--spacing-4xl) 0;
  }

  .section-title {
    font-size: 2.5rem;
    font-weight: 600;
    text-align: center;
    margin-bottom: var(--spacing-3xl);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--spacing-2xl);
  }

  .cta-section {
    padding: var(--spacing-4xl);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-xl);
    text-align: center;
    margin: var(--spacing-4xl) 0;
  }

  .cta-content h2 {
    font-size: 2.5rem;
    font-weight: 600;
    margin-bottom: var(--spacing-lg);
  }

  .cta-content p {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-2xl);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-buttons {
    display: flex;
    gap: var(--spacing-lg);
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 var(--spacing-lg);
    }

    .section-title {
      font-size: 2rem;
    }

    .cta-content h2 {
      font-size: 2rem;
    }
  }
</style>
