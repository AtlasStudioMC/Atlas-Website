---
import Layout from "@/layouts/Layout.astro";
import { SERVERS } from "@/data/servers";
import { VERSIONS, FORK_INFO, brandFor, type Fork } from "@/data/versions";
import { GALLERY } from "@/data/gallery";
import ShotCredit from "@/components/ShotCredit.astro";

const features = [
  {
    title: "We test everything",
    body: "Before we turn a setting on, we check it properly. If it could break your world, we leave it off.",
  },
  {
    title: "Your plugins still work",
    body: "Anything made for Paper, Purpur or Spigot runs here. One setting in the tuned config switches off hopper events for speed \u2014 if you use a shop or sorting plugin, turn that one back on.",
  },
  {
    title: "Old versions too",
    body: "16 versions, from 1.20 all the way to 26.2. Every one gets the same care.",
  },
];

// These are also emitted as FAQPage structured data by Layout, so keep every answer literally
// true and self-contained - it can show up in a search result with no page around it.
const faqs = [
  {
    q: "Do my plugins still work?",
    a: "Yes \u2014 the jar runs anything built for Paper or Spigot. The one thing to know: our tuned config turns off hopper move events, because that is the single biggest speed win available. Plugins that watch hoppers, like shops and item sorters, need it switched back on. Set hopper.disable-move-event to false in paper-world-defaults.yml and they work again.",
  },
  {
    q: "Is Atlas free?",
    a: "Yes, completely. It's free to download, and the source is public under the same licenses as the projects it's built on.",
  },
  {
    q: "How much faster is it than Paper?",
    a: "On Minecraft 1.21.4 we measured it generating new chunks 9.6% faster than stock Paper. That is the one number we can stand behind. We also tested 26.2 and the result was too noisy to call \u2014 it looked faster on average, but the test machine varied more between runs than the two servers differed from each other, so we are not claiming a figure for it. The hardware, settings and raw results for both are on the benchmarks page.",
  },
  {
    q: "Which Minecraft versions are supported?",
    a: "Minecraft 1.20 through 26.2. Each version is its own build, so you download the one matching your server.",
  },
  {
    q: "How do I install it?",
    a: "Swap your current server jar for the Atlas one and start the server as normal. Your worlds, plugins and settings stay where they are.",
  },
  {
    q: "Did you build this from scratch?",
    a: "No. We take Leaf or Purpur, tune the settings, test them, and put our name on it.",
  },
  {
    q: "Is it safe for my server?",
    a: "We test every change before turning it on, and we list the ones we skipped and why. Keep a backup anyway — that's good advice for any server software.",
  },
];

// Real measured numbers from benchmarks/results-1.21.4.txt in the Atlas repo. Average
// tick time over 400 sampled ticks, same seed, same JVM flags, same machine. Labelled on the page
// as 1.21.4 because that is what was measured - 26.2 was tested and came out too noisy to publish.
const bench = {
  version: "1.21.4",
  scenarios: [
    { name: "300 entities", atlas: 4.8745, paper: 6.735 },
    { name: "1,000 entities", atlas: 8.1114, paper: 25.7943 },
  ],
};
const heavy = bench.scenarios[1];
const factor = (heavy.paper / heavy.atlas).toFixed(1);
const chartMax = 28;

const forks: Fork[] = (["Leaf", "Purpur", "Paper"] as Fork[]).filter((fork) =>
  VERSIONS.some((v) => v.fork === fork)
);
const releasedCount = VERSIONS.filter((v) => v.status === "released").length;
const latestVersion = VERSIONS.find((v) => v.status === "released")?.version ?? VERSIONS[0].version;
// Static content, so it ships as a prerendered file served straight from the CDN edge
// rather than booting a serverless function per request. Only /downloads needs SSR (it
// reads the GitHub releases API at request time).
export const prerender = true;
---

<Layout
  title="Atlas Studio — Free Minecraft Server Jar & Proxy"
  description="Free, optimized Minecraft server software from Atlas Studio: the Atlas server jar for 1.20 through 26.2, and the Astro proxy. Built on Leaf and Purpur, free to download."
  faq={faqs}
>
  {/* Hero. Deliberately sparse: one statement, one action, and the artwork carrying the rest.
      Original voxel art, generated by scripts/generate-scenes.mjs - no game assets. */}
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <picture>
        <source media="(max-width: 640px)" srcset="/mc-frozen-ocean-sm.webp" type="image/webp" />
        <img
          src="/mc-frozen-ocean.webp"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover object-bottom"
        />
      </picture>
      {/* A real daylight screenshot is far brighter than the generated scene this scrim was
          tuned for, and white display type over pale sky is unreadable. Darkened enough to
          hold contrast, plus a flat wash so the middle of the image cannot wash out either. */}
      <div class="absolute inset-0 bg-[#080a14]/45"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[#080a14]/70 via-[#080a14]/30 to-[#080a14]"></div>
    </div>
    <div class="pointer-events-none absolute right-4 bottom-3 z-10">
      <ShotCredit shot="mc-frozen-ocean" />
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_58%_50%_at_50%_40%,rgba(8,10,20,0.34),transparent_80%)]"></div>
    </div>

    <div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center gap-8 px-6 pt-36 pb-40 text-center lg:pt-52 lg:pb-56">
      <a href="/downloads" class="text-sm text-white/55 transition-colors hover:text-white/80">
        <span class="font-mono text-primary-400">{latestVersion}</span> is out now
      </a>

      <h1 class="text-5xl leading-[1.03] font-semibold tracking-tight text-balance sm:text-6xl lg:text-7xl">
        Faster where it<br class="hidden sm:block" /> actually hurts.
      </h1>

      <p class="max-w-xl text-lg leading-relaxed text-white/70 [text-shadow:0_1px_14px_rgba(8,10,20,0.9)]">
        A free Minecraft server jar and proxy. Drop one file in, keep every plugin, and hold your
        tick rate when the mobs pile up.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a href="/downloads" class="btn-primary px-7 py-3 text-sm">Download</a>
        <a href="#performance" class="btn-ghost px-7 py-3 text-sm font-medium text-white">See the numbers</a>
      </div>
    </div>
  </section>

  {/* The measured result. This is the strongest honest thing the project has, so it gets the
      space: one number, the chart behind it, and the caveats attached rather than buried. */}
  <section id="performance" class="relative mx-auto max-w-5xl scroll-mt-20 px-6 pt-28 pb-28 lg:pt-40 lg:pb-36">
    <div class="mb-16 text-center">
      <p class="mb-5 text-sm font-medium tracking-wide text-primary-400 uppercase">Measured, not estimated</p>
      <h2 class="text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl">
        <span class="text-primary-400">{factor}×</span> the headroom<br class="hidden sm:block" /> under a thousand mobs.
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-white/60">
        Tick time is what decides whether your server feels smooth. Lower is better. Both servers ran
        the same world, the same seed and the same JVM flags on one machine.
      </p>
    </div>

    <div class="surface p-8 sm:p-12">
      {
        bench.scenarios.map((sc) => (
          <div class="mb-10 last:mb-0">
            <p class="mb-5 text-sm font-medium text-white/50">{sc.name}</p>
            <div class="space-y-4">
              <div>
                <div class="mb-1.5 flex items-baseline justify-between gap-4">
                  <span class="text-sm font-medium text-white">Atlas</span>
                  <span class="font-mono text-sm text-primary-400">{sc.atlas.toFixed(2)} ms</span>
                </div>
                <div class="h-2.5 w-full overflow-hidden rounded-full bg-white/[0.06]">
                  <div class="h-full rounded-full bg-primary-500" style={`width:${(sc.atlas / chartMax) * 100}%`}></div>
                </div>
              </div>
              <div>
                <div class="mb-1.5 flex items-baseline justify-between gap-4">
                  <span class="text-sm font-medium text-white/60">Paper</span>
                  <span class="font-mono text-sm text-white/45">{sc.paper.toFixed(2)} ms</span>
                </div>
                <div class="h-2.5 w-full overflow-hidden rounded-full bg-white/[0.06]">
                  <div class="h-full rounded-full bg-white/25" style={`width:${(sc.paper / chartMax) * 100}%`}></div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
      <p class="mt-10 border-t border-white/[0.07] pt-6 text-xs leading-relaxed text-white/40">
        Minecraft {bench.version}, average tick time over 400 sampled ticks, Apple M3 Pro, 4GB heap.
        One machine, so treat it as an indication rather than a promise &mdash; your hardware will differ.
        We also tested 26.2 and the runs varied too much to publish a number, which we say so on the
        <a href="/benchmarks" class="text-primary-400 underline">benchmarks page</a> along with the raw output.
      </p>
    </div>
  </section>

  {/* Full-bleed break, and the one place a real screenshot earns a hero-sized slot. The source
      is 1024px - every CC-licensed in-game screenshot is, they are all old Flickr uploads - so it
      is upscaled with lanczos and a light sharpen. Blocky geometry survives that; a photograph
      would not have. The credit sits in the corner because a band has nowhere else to put it,
      and CC BY-SA wants it with the work. */}
  <section class="relative h-[42vh] min-h-[280px] overflow-hidden sm:h-[52vh]">
    <picture>
      <source media="(max-width: 640px)" srcset="/mc-taiga-sm.webp" type="image/webp" />
      <img
        src="/mc-taiga.webp"
        alt="A snowy Minecraft taiga with spruce forest and open water"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-center"
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-b from-[#080a14] via-transparent to-[#080a14]"></div>
    <div class="absolute right-4 bottom-3"><ShotCredit shot="mc-taiga" /></div>
  </section>

  <section id="products" class="relative mx-auto max-w-5xl px-6 pb-28 lg:pb-36">
    <div class="mb-12 text-center">
      <h2 class="mb-4 text-3xl font-semibold tracking-tight text-balance sm:text-4xl lg:text-5xl">Three things we make</h2>
      <p class="mx-auto max-w-xl text-white/55">
        Most people only need the first one.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      <div class="surface surface-hover flex flex-col p-8">
        <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2">
          <h3 class="text-xl font-semibold text-white">Atlas</h3>
          <span class="pill pill-on">{latestVersion}</span>
          <span class="pill">{brandFor(latestVersion)}</span>
        </div>
        <p class="mb-1 text-sm font-medium text-white/70">A server jar</p>
        <p class="mb-6 text-sm leading-relaxed text-white/50">
          This is the file your server runs on. Swap it for the one you have now and everything gets a bit
          faster — same worlds, same plugins, same settings.
        </p>
        <div class="mt-auto flex flex-wrap items-center gap-3">
          <a href="/downloads" class="btn-primary px-5 py-2.5 text-sm">Download</a>
          <a href="/docs" class="text-sm text-white/45 underline decoration-white/20 underline-offset-4 hover:text-primary-400">
            How to set it up
          </a>
        </div>
      </div>

      <div class="surface surface-hover flex flex-col p-8">
        <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2">
          <h3 class="text-xl font-semibold text-white">Astro</h3>
          <span class="pill pill-on">build-1</span>
        </div>
        <p class="mb-1 text-sm font-medium text-white/70">A proxy</p>
        <p class="mb-6 text-sm leading-relaxed text-white/50">
          Only needed if you run more than one server. It sits in front of them and moves players between
          them, so a lobby and a survival world feel like one place.
        </p>
        <div class="mt-auto flex flex-wrap items-center gap-3">
          <a
            href="https://github.com/AtlasStudioMC/Astro/releases/download/build-1/AstroVelocity-b1.jar"
            class="btn-primary px-5 py-2.5 text-sm"
          >
            Download
          </a>
          <a
            href="https://github.com/AtlasStudioMC/Astro"
            class="text-sm text-white/45 underline decoration-white/20 underline-offset-4 hover:text-primary-400"
          >
            Source ↗
          </a>
        </div>
      </div>

      <div class="surface surface-hover flex flex-col p-8">
        <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2">
          <h3 class="text-xl font-semibold text-white">Aurora</h3>
          <span class="pill pill-on">build 1</span>
        </div>
        <p class="mb-1 text-sm font-medium text-white/70">A regionised server</p>
        <p class="mb-3 text-sm leading-relaxed text-white/50">
          Our fork of CanvasMC. Spreads the world across CPU cores instead of ticking it all on one
          thread, which is how you get past a single core on a big world.
        </p>
        <p class="mb-6 text-sm leading-relaxed text-amber-200/70">
          Most plugins will not load on it. Read the caveat before you try it.
        </p>
        <div class="mt-auto flex flex-wrap items-center gap-3">
          <a href="/downloads?t=aurora" class="btn-primary px-5 py-2.5 text-sm">Download</a>
          <a
            href="https://github.com/AtlasStudioMC/Aurora"
            class="text-sm text-white/45 underline decoration-white/20 underline-offset-4 hover:text-primary-400"
          >
            Source ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Real Minecraft screenshots, unlike the generated scenes everywhere else on this site.
      Every one is used under a Creative Commons licence its photographer granted. CC BY and
      CC BY-SA both require the credit to sit with the work, so it renders in the card - not
      collapsed into a footnote nobody reads. */}
  <section class="relative mx-auto max-w-6xl px-6 pb-28 lg:pb-36">
    <div class="mb-10 text-center">
      <h2 class="mb-4 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">What people build</h2>
      <p class="mx-auto max-w-xl text-white/55">
        None of this is ours. It is what the game is for, and it is the reason any of the work
        below the surface matters.
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        GALLERY.map((g) => (
          <figure class="surface overflow-hidden">
            <picture>
              <source media="(max-width: 640px)" srcset={`/${g.file}-sm.webp`} type="image/webp" />
              <img
                src={`/${g.file}.webp`}
                alt={g.title}
                width="1024"
                height="640"
                loading="lazy"
                decoding="async"
                class="aspect-[16/10] w-full object-cover"
              />
            </picture>
            <figcaption class="px-5 py-4 text-xs leading-relaxed text-white/40">
              <a href={g.sourceUrl} rel="noopener" class="text-white/60 underline decoration-white/20 underline-offset-4 hover:text-primary-400">{g.title}</a>
              {" by "}
              {g.creatorUrl
                ? <a href={g.creatorUrl} rel="noopener" class="underline decoration-white/15 underline-offset-4 hover:text-primary-400">{g.creator}</a>
                : g.creator}
              {", licensed "}
              <a href={g.licenseUrl} rel="noopener license" class="underline decoration-white/15 underline-offset-4 hover:text-primary-400">{g.license}</a>
              {". Cropped, otherwise unmodified."}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="relative mx-auto max-w-6xl px-6 pb-28 lg:pb-36">
    <h2 class="mb-14 text-center text-3xl font-semibold tracking-tight text-balance sm:text-4xl lg:text-5xl">What you get</h2>
    <div class="grid gap-5 md:grid-cols-3">
      {
        features.map((f) => (
          <div class="surface surface-hover p-7">
            <h3 class="mb-2 text-lg font-semibold text-white">{f.title}</h3>
            <p class="text-sm leading-relaxed text-white/55">{f.body}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-center text-sm text-white/40">
      See everything we changed on the <a href="/tuning" class="text-primary-400 underline">tuning page</a>.
    </p>
  </section>

  <section id="versions" class="relative mx-auto max-w-5xl px-6 pb-28 lg:pb-36">
    <div class="mb-12 text-center">
      <h2 class="mb-4 text-3xl font-semibold tracking-tight text-balance sm:text-4xl lg:text-5xl">Pick your version</h2>
      <p class="mx-auto max-w-xl text-white/55">
        Newer versions are built on Leaf. Older ones use Purpur, going back to 1.20.
      </p>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      {
        forks.map((fork) => {
          const versions = VERSIONS.filter((v) => v.fork === fork);
          const shipped = versions.filter((v) => v.status === "released").length;
          return (
            <div class="surface surface-hover p-7">
              <div class="mb-1.5 flex flex-wrap items-center gap-x-3 gap-y-1">
                {FORK_INFO[fork].logo && (
                  <img src={FORK_INFO[fork].logo} alt="" width="20" height="20" class="shrink-0" />
                )}
                <h3 class="text-xl font-semibold">{fork}</h3>
                <span class="rounded-full bg-white/[0.06] px-2.5 py-0.5 font-mono text-[11px] text-white/50">
                  {shipped} versions
                </span>
                <a
                  href={FORK_INFO[fork].href}
                  class="ml-auto text-xs text-white/40 underline decoration-white/20 underline-offset-4 transition-colors hover:text-primary-400"
                >
                  GitHub ↗
                </a>
              </div>
              <p class="mb-5 text-sm leading-relaxed text-white/45">{FORK_INFO[fork].blurb}</p>
              <ul class="flex flex-wrap gap-2">
                {versions.map((v) => (
                  <li
                    class:list={["pill", v.status === "released" ? "pill-on" : "pill-off"]}
                    title={v.status === "released" ? "Ready to download" : "Not made yet"}
                  >
                    {v.version}
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
    <p class="mt-7 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-white/40">
      <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-primary-400"></span> ready to download</span>
      <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-white/20"></span> not made yet</span>
    </p>
  </section>

  <section class="relative mx-auto max-w-3xl px-6 pb-28 lg:pb-36">
    <h2 class="mb-12 text-center text-3xl font-semibold tracking-tight text-balance sm:text-4xl lg:text-5xl">Common questions</h2>
    <div class="space-y-3">
      {
        faqs.map((f) => (
          <details class="surface group p-6 transition-colors open:bg-white/[0.04]">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-white marker:content-none">
              <span>{f.q}</span>
              <span class="shrink-0 text-lg leading-none text-primary-400 transition-transform duration-200 group-open:rotate-45">
                +
              </span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-white/60">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="relative mx-auto max-w-4xl px-6 pb-28 text-center lg:pb-36">
    <h2 class="mb-5 text-3xl font-semibold tracking-tight text-balance sm:text-4xl lg:text-5xl">Who's running it</h2>
    <p class="mx-auto mb-10 max-w-xl text-white/55">
      Real servers, counted by bStats. The graph below is live — it's whatever the number actually is
      right now, not a number we typed in.
    </p>

    {
      SERVERS.length > 0 && (
        <div class="mb-10 flex flex-wrap items-center justify-center gap-x-12 gap-y-8">
          {SERVERS.map((server) =>
            server.href ? (
              <a
                href={server.href}
                class="opacity-70 transition-opacity hover:opacity-100"
                title={server.name}
              >
                {server.logo ? (
                  <img src={server.logo} alt={server.name} height="56" class="h-14 w-auto" loading="lazy" />
                ) : (
                  <span class="text-lg font-semibold text-white/70">{server.name}</span>
                )}
              </a>
            ) : (
              <div class="opacity-70" title={server.name}>
                {server.logo ? (
                  <img src={server.logo} alt={server.name} height="56" class="h-14 w-auto" loading="lazy" />
                ) : (
                  <span class="text-lg font-semibold text-white/70">{server.name}</span>
                )}
              </div>
            )
          )}
        </div>
      )
    }

    {/* The service is registered on bStats as "AtlasSpigot" (id 33733) and that name is NOT
        ours to change from here - it is changed on bStats or not at all.

        This matters more than it looks. bStats serves a signature for any name you ask for, so
        .../signatures/bukkit/Atlas.svg returns 200 - but it is a different developer's plugin,
        "Atlas by funkemunky". Renaming this URL to match our branding silently published
        somebody else's server counts under our own "not a number we typed in" heading. */}
    <a href="https://bstats.org/plugin/bukkit/AtlasSpigot/33733" class="surface surface-hover inline-block overflow-hidden p-3">
      <img src="https://bstats.org/signatures/bukkit/AtlasSpigot.svg" alt="Servers running Atlas, counted by bStats" class="mx-auto rounded-lg" />
    </a>

    <p class="mx-auto mt-6 max-w-xl text-sm text-white/40">
      Running Atlas and want your server listed here?
      <a href="https://github.com/AtlasStudioMC/Atlas/issues/new" class="text-primary-400 underline">Open an issue</a>
      with your name and logo.
    </p>
  </section>

  <section class="relative h-[38vh] min-h-[240px] overflow-hidden sm:h-[46vh]">
    <picture>
      <source media="(max-width: 640px)" srcset="/mc-end-sm.webp" type="image/webp" />
      <img src="/mc-end.webp" alt="The Minecraft End, obsidian pillars over pale endstone" loading="lazy" decoding="async" class="h-full w-full object-cover object-center" />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-b from-[#080a14] via-transparent to-[#080a14]"></div>
    <div class="absolute right-4 bottom-3"><ShotCredit shot="mc-end" /></div>
  </section>

  <section class="relative mx-auto max-w-4xl px-6 pb-32 lg:pb-40">
    <div class="surface px-8 py-16 text-center">
      <h2 class="mb-5 text-3xl font-semibold tracking-tight text-balance sm:text-4xl lg:text-5xl">Ready to try it?</h2>
      <p class="mx-auto mb-8 max-w-md text-white/55">Download one file and drop it into your server folder.</p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="/downloads" class="btn-primary px-6 py-3 text-sm">Download {latestVersion}</a>
        <a href="/docs" class="btn-ghost px-6 py-3 text-sm font-medium text-white">How to set it up</a>
      </div>
    </div>
  </section>
</Layout>
