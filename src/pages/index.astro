---
import Layout from "@/layouts/Layout.astro";
import { VERSIONS, FORK_INFO, type Fork } from "@/data/versions";

const features = [
  {
    title: "Screened, not guessed",
    body: "Every setting is checked against upstream's own source, @Experimental/@Deprecated flags, and issue tracker before it ships - re-audited periodically, not just at launch.",
  },
  {
    title: "Rebranded at the source",
    body: "Every brand-facing string - F3 debug text, MOTD, console banner, crash reports - reads AtlasSpigot, fixed in the build manifest itself. Works with zero config present.",
  },
  {
    title: "Every version, one philosophy",
    body: "Modern versions build on Leaf, older ones on Purpur - same rebrand and the same tuning rigor on every single track, not just the flagship one.",
  },
];

const configHighlights = [
  "Real config, real diffs - every source patch lives in the repo, not just a changelog line",
  "Two source-rebuilt forks (Leaf, Purpur), one shared tuning philosophy across every version",
  "Documented deltas - each version's own NOTES.md records what's different and why",
];

const faqs = [
  {
    q: "Is this a fork from scratch?",
    a: "No - each version is Leaf or Purpur, whichever one actually has buildable source for that Minecraft version, source-rebuilt with a real brand change baked into the jar and a documented set of tuning changes on top.",
  },
  {
    q: "Will my plugins work?",
    a: "Yes. AtlasSpigot is Paper-API compatible through Leaf/Purpur - plugins built for Bukkit/Paper/Purpur run unmodified.",
  },
  {
    q: "How do I know a setting is actually safe?",
    a: "Every change is checked against upstream's own experimental/deprecated flags and issue tracker before shipping - the full methodology and what was deliberately left off are both on the tuning page.",
  },
];

const forks: Fork[] = (["Leaf", "Purpur", "Paper"] as Fork[]).filter((fork) =>
  VERSIONS.some((v) => v.fork === fork)
);
const releasedCount = VERSIONS.filter((v) => v.status === "released").length;
const latestVersion = VERSIONS.find((v) => v.status === "released")?.version ?? VERSIONS[0].version;

const configSnippet = `# AtlasSpigot config — partial view (atlas-global.yml)
async:
  async-chunk-send:
    enabled: true

performance:
  dab:
    enabled: true
    start-distance: 12
  optimized-powered-rails: true

misc:
  rebrand:
    server-mod-name: AtlasSpigot

# … FIXES / NETWORK / GAMEPLAY and more not shown`;
---

<Layout
  title="AtlasSpigot"
  description="A tuned, rebranded Minecraft server spanning Purpur and Leaf - real performance changes, checked against upstream before they ship."
>
  <section class="relative overflow-hidden">
    <div class="glow-field">
      <div class="glow-orb h-[500px] w-[500px] bg-primary-600 -top-40 -left-20"></div>
      <div class="glow-orb h-[420px] w-[420px] bg-primary-400 top-10 right-0"></div>
    </div>
    <div class="grid-texture absolute inset-x-0 top-0 h-[600px]"></div>

    <div class="relative z-10 mx-auto flex max-w-3xl flex-col items-center gap-6 px-6 pt-28 pb-16 text-center lg:pt-36 lg:pb-20">
      <a
        href="/downloads"
        class="flex items-center gap-2 rounded-full border border-primary-500/30 bg-primary-500/10 px-4 py-1.5 text-sm text-primary-300 transition-colors hover:border-primary-400/50"
      >
        <img src="/logo.svg" alt="" width="16" height="16" />
        {latestVersion} released
      </a>

      <h1 class="text-4xl leading-tight font-bold sm:text-5xl lg:text-6xl">
        The tuning has <span class="gradient-text italic">receipts</span>.
      </h1>

      <p class="max-w-xl text-base text-white/70 sm:text-lg">
        A tuned Minecraft server spanning <a href={FORK_INFO.Purpur.href} class="text-primary-400 underline">Purpur</a> and <a href={FORK_INFO.Leaf.href} class="text-primary-400 underline">Leaf</a>, full plugin compatibility, and every performance claim backed by a real diff and a real benchmark — not a config comment asking you to trust it.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 pt-1">
        <a href="/downloads" class="btn-glow rounded-lg bg-primary-500 px-7 py-3 font-medium text-black">
          Get started
        </a>
        <a
          href="https://github.com/AtlasStudioMC/AtlasSpigot"
          class="rounded-lg border border-white/15 px-7 py-3 font-medium text-white transition-colors hover:border-white/30"
        >
          View on GitHub
        </a>
      </div>
    </div>
  </section>

  <section class="relative mx-auto max-w-5xl px-6 pb-24">
    <div class="grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:grid-cols-3">
      <a href="/benchmarks" class="card-hover bg-[#0c0f16] px-6 py-8 text-center">
        <div class="text-3xl font-semibold text-primary-400">9.6%</div>
        <div class="mt-1 text-sm text-white/60">Faster chunk generation vs. stock Paper — measured, not estimated</div>
      </a>
      <div class="bg-[#0c0f16] px-6 py-8 text-center">
        <div class="text-3xl font-semibold text-primary-400">{releasedCount}</div>
        <div class="mt-1 text-sm text-white/60">Minecraft versions covered, each with its own tuned config</div>
      </div>
      <a href="/tuning" class="card-hover bg-[#0c0f16] px-6 py-8 text-center">
        <div class="text-3xl font-semibold text-primary-400">0</div>
        <div class="mt-1 text-sm text-white/60">Settings enabled because they sounded fast, not because they were verified</div>
      </a>
    </div>
    <p class="mt-4 text-center text-xs text-white/40">
      Real, reproducible numbers on the <a href="/benchmarks" class="text-primary-400 underline">benchmarks page</a> — methodology and raw results included.
    </p>
  </section>

  <section class="relative mx-auto max-w-6xl px-6 pb-24">
    <div class="mb-10 text-center">
      <p class="mb-2 text-xs font-semibold tracking-widest text-primary-400 uppercase">What you get</p>
      <h2 class="mb-2 text-2xl font-medium lg:text-3xl">Three things matter most. The rest is in the docs.</h2>
      <p class="mx-auto max-w-xl text-sm text-white/50">Every tuning change traces back to one of these.</p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {
        features.map((f) => (
          <div class="card-hover rounded-2xl border border-white/10 bg-white/5 p-6">
            <h3 class="mb-2 font-medium text-primary-300">{f.title}</h3>
            <p class="text-sm text-white/60">{f.body}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-center text-sm text-white/40">
      Full breakdown, including what was deliberately <em>not</em> enabled and why, on the <a href="/tuning" class="text-primary-400 underline">tuning page</a>.
    </p>
  </section>

  <section class="relative mx-auto max-w-6xl px-6 pb-24">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class="mb-2 text-xs font-semibold tracking-widest text-primary-400 uppercase">Take a look</p>
        <h2 class="mb-4 text-2xl font-medium lg:text-3xl">Change what you need. Leave the rest.</h2>
        <p class="mb-5 text-white/60">
          A flat YAML config, same as upstream Leaf/Purpur, plus AtlasSpigot's own rebrand keys. Every tuning
          delta is a real diff in the repo, not a paragraph asking you to trust it.
        </p>
        <ul class="mb-5 space-y-2 text-sm text-white/70">
          {
            configHighlights.map((h) => (
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary-400" />
                {h}
              </li>
            ))
          }
        </ul>
        <a href="/tuning" class="font-medium text-primary-400 underline">Read the tuning guide →</a>
      </div>
      <div class="rounded-2xl border border-white/10 bg-black/40 p-1">
        <div class="flex items-center gap-1.5 border-b border-white/5 px-4 py-2.5 text-xs text-white/40">
          <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
          <span class="ml-2 font-mono">atlas-global.yml</span>
        </div>
        <pre class="overflow-x-auto p-4 font-mono text-xs leading-relaxed text-white/70"><code>{configSnippet}</code></pre>
      </div>
    </div>
  </section>

  <section id="versions" class="relative mx-auto max-w-5xl px-6 pb-24">
    <div class="mb-10 text-center">
      <p class="mb-2 text-xs font-semibold tracking-widest text-primary-400 uppercase">Version coverage</p>
      <h2 class="mb-2 text-2xl font-medium lg:text-3xl">Every version, one build philosophy</h2>
      <p class="mx-auto max-w-2xl text-sm text-white/60">
        Modern versions build on Leaf. Older ones, back to versions Leaf never supported, use Purpur - down to 1.20
        right now. Same tuning rigor and rebrand on every one.
      </p>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {
        forks.map((fork) => {
          const versions = VERSIONS.filter((v) => v.fork === fork);
          return (
            <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
              <div class="mb-1 flex items-center gap-2">
                <h3 class="text-lg font-medium">{fork}</h3>
                <a href={FORK_INFO[fork].href} class="text-xs text-primary-400 underline">
                  upstream
                </a>
              </div>
              <p class="mb-4 text-xs text-white/50">{FORK_INFO[fork].blurb}</p>
              <ul class="flex flex-wrap gap-2">
                {versions.map((v) => (
                  <li
                    class:list={[
                      "rounded-md px-2 py-1 font-mono text-xs",
                      v.status === "released" ? "bg-primary-500/15 text-primary-300" : "bg-white/5 text-white/35",
                    ]}
                    title={v.status === "released" ? "Released" : "Planned"}
                  >
                    {v.version}
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
    <p class="mt-6 text-center text-xs text-white/40">
      <span class="mr-1 inline-block h-2 w-2 rounded-full bg-primary-400 align-middle"></span> released &nbsp;
      <span class="mr-1 inline-block h-2 w-2 rounded-full bg-white/20 align-middle"></span> planned, not shipped yet
    </p>
  </section>

  <section class="relative mx-auto max-w-3xl px-6 pb-24">
    <h2 class="mb-6 text-center text-2xl font-medium lg:text-3xl">Quick start</h2>
    <div class="rounded-2xl border border-white/10 bg-black/40 p-6 font-mono text-sm text-white/80">
      <p class="mb-1 text-white/40"># after downloading the jar and copying the matching config alongside it</p>
      <p><span class="text-primary-400">$</span> chmod +x start.sh</p>
      <p><span class="text-primary-400">$</span> ./start.sh</p>
    </div>
    <p class="mt-4 text-center text-sm text-white/40">
      Set <code>eula=true</code> first — vanilla Minecraft requires it. Full steps, hosting-panel notes, and
      first-boot timing on the <a href="/downloads" class="text-primary-400 underline">Downloads page</a>.
    </p>
  </section>

  <section class="relative mx-auto max-w-3xl px-6 pb-24">
    <div class="mb-8 text-center">
      <p class="mb-2 text-xs font-semibold tracking-widest text-primary-400 uppercase">You might be wondering</p>
      <h2 class="text-2xl font-medium lg:text-3xl">Frequently asked questions</h2>
      <p class="mt-2 text-sm text-white/50">
        More detail in the <a href="/docs" class="text-primary-400 underline">docs</a>.
      </p>
    </div>
    <div class="space-y-3">
      {
        faqs.map((f) => (
          <details class="rounded-2xl border border-white/10 bg-white/5 p-5">
            <summary class="cursor-pointer list-none font-medium text-white marker:content-none">{f.q}</summary>
            <p class="mt-2.5 text-sm text-white/70">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="relative mx-auto max-w-4xl px-6 pb-24 text-center">
    <h2 class="mb-4 text-2xl font-medium lg:text-3xl">Real usage, not a fabricated graph</h2>
    <p class="mx-auto mb-6 max-w-2xl text-sm text-white/60">
      This is a genuine, registered <a href="https://bstats.org" class="text-primary-400 underline">bStats</a> project - it starts at zero
      like any new project does, and only grows as real AtlasSpigot servers report in.
    </p>
    <a href="https://bstats.org/plugin/bukkit/AtlasSpigot/33733" class="inline-block">
      <img
        src="https://bstats.org/signatures/bukkit/AtlasSpigot.svg"
        alt="bStats Graph Data"
        class="mx-auto rounded-xl border border-white/10"
      />
    </a>
  </section>

  <section class="relative mx-auto max-w-3xl px-6 pb-28 text-center">
    <div class="rounded-3xl border border-white/10 bg-white/5 px-8 py-14">
      <h2 class="mb-3 text-3xl font-semibold lg:text-4xl">Your server is ready. So is AtlasSpigot.</h2>
      <p class="mx-auto mb-7 max-w-xl text-white/60">
        One jar, minimal effort - drops into your existing server setup.
      </p>
      <a href="/downloads" class="btn-glow inline-block rounded-lg bg-primary-500 px-7 py-3 font-medium text-black">
        Download {latestVersion}
      </a>
    </div>
  </section>
</Layout>
