---
import Layout from "@/layouts/Layout.astro";
import { VERSIONS, FORK_INFO, brandFor, type Fork } from "@/data/versions";

const features = [
  {
    title: "We test everything",
    body: "Before we turn a setting on, we check it properly. If it could break your world, we leave it off.",
  },
  {
    title: "Your plugins still work",
    body: "Anything made for Paper, Purpur or Spigot runs here. One setting in the tuned config switches off hopper events for speed — if you use a shop or sorting plugin, turn that one back on.",
  },
  {
    title: "Old versions too",
    body: "16 versions, from 1.20 all the way to 26.2. Every one gets the same care.",
  },
];

// These are also emitted as FAQPage structured data by Layout, so keep every answer literally
// true and self-contained - it can show up in a search result with no page around it.
const faqs = [
  {
    q: "Do my plugins still work?",
    a: "Yes — the jar runs anything built for Paper or Spigot. The one thing to know: our tuned config turns off hopper move events, because that is the single biggest speed win available. Plugins that watch hoppers, like shops and item sorters, need it switched back on. Set hopper.disable-move-event to false in paper-world-defaults.yml and they work again.",
  },
  {
    q: "Is Atlas free?",
    a: "Yes, completely. It's free to download, and the source is public under the same licenses as the projects it's built on.",
  },
  {
    q: "How much faster is it than Paper?",
    a: "On Minecraft 1.21.4 we measured it generating new chunks 9.6% faster than stock Paper. That is the one number we can stand behind. We also tested 26.2 and the result was too noisy to call — it looked faster on average, but the test machine varied more between runs than the two servers differed from each other, so we are not claiming a figure for it. The hardware, settings and raw results for both are on the benchmarks page.",
  },
  {
    q: "Which Minecraft versions are supported?",
    a: "Minecraft 1.20 through 26.2. Each version is its own build, so you download the one matching your server.",
  },
  {
    q: "How do I install it?",
    a: "Swap your current server jar for the Atlas one and start the server as normal. Your worlds, plugins and settings stay where they are.",
  },
  {
    q: "What is Aurora?",
    a: "A separate, regionised fork built on Folia/CanvasMC that spreads the world across CPU cores instead of ticking it on one thread. Most plugins will not load on it unless they explicitly declare support — check the downloads page before switching.",
  },
  {
    q: "Did you build this from scratch?",
    a: "No. We take Leaf or Purpur, tune the settings, test them, and put our name on it.",
  },
  {
    q: "Is it safe for my server?",
    a: "We test every change before turning it on, and we list the ones we skipped and why. Keep a backup anyway — that's good advice for any server software.",
  },
];

// Photos of physical Minecraft merchandise, licensed under the Unsplash License (free for
// commercial use, no attribution required). Credited anyway, same as everywhere else on this
// site - not a licence obligation here, just consistent practice. These are photographs of real
// objects, not screenshots of the game itself, which is what keeps them clear of Mojang's own
// usage guidelines (those restrict commercial use of *their* assets, not a photographer's photo
// of a toy someone bought).
const shots = [
  {
    src: "https://images.unsplash.com/photo-1772080543578-2b8322bdcf4e?w=640&h=480&fit=crop",
    alt: "Two Minecraft skeleton mob figures on rubble",
    photographer: "Tahoe Groeger",
    sourceUrl: "https://unsplash.com/photos/two-skeleton-figures-stand-on-rubble-l3ncNQLN14A",
  },
  {
    src: "https://images.unsplash.com/photo-1524685794168-52985e79c1f8?w=640&h=480&fit=crop",
    alt: "A Minecraft Steve character figure",
    photographer: "Mona Rivas",
    sourceUrl: "https://unsplash.com/photos/minecraft-steve-toy-6eL_lMJDwjM",
  },
  {
    src: "https://images.unsplash.com/photo-1759663174699-d0e64ed0fb66?w=640&h=480&fit=crop",
    alt: "Two Minecraft zombie mob figures",
    photographer: "Addy Spartacus",
    sourceUrl: "https://unsplash.com/photos/two-green-headed-figures-with-blue-shirts-and-purple-pants-9tBGruMvQr0",
  },
  {
    src: "https://images.unsplash.com/photo-1589609966838-5c628d5c1aa5?w=640&h=480&fit=crop",
    alt: "A phone showing the Minecraft Earth loading screen",
    photographer: "Joshua Hoehne",
    sourceUrl: "https://unsplash.com/photos/a-hand-holding-a-cell-phone-with-a-game-on-the-screen-qdhYA-8d1RE",
  },
];

const forks: Fork[] = (["Leaf", "Purpur", "Paper"] as Fork[]).filter((fork) =>
  VERSIONS.some((v) => v.fork === fork)
);
const releasedCount = VERSIONS.filter((v) => v.status === "released").length;
const latestVersion = VERSIONS.find((v) => v.status === "released")?.version ?? VERSIONS[0].version;

// Static content, so it ships as a prerendered file served straight from the CDN edge
// rather than booting a serverless function per request. Only /downloads needs SSR (it
// reads the GitHub releases API at request time).
export const prerender = true;
---

<Layout
  title="Atlas Studio — Free Minecraft Server Jar & Proxy"
  description="Free, optimized Minecraft server software from Atlas Studio: the Atlas/Astra server jar for 1.20 through 26.2, the Astro proxy, and Aurora, a regionised fork. Your plugins keep working."
  faq={faqs}
>
  <section class="relative overflow-hidden">
    {/* Voxel landscape backdrop. Original artwork, not a Minecraft screenshot - see the note in
        PageHero.astro. Served as WebP at two widths so phones don't pull the desktop asset, and
        laid under a gradient scrim that keeps headline contrast well clear of the busy areas. */}
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <picture>
        <source media="(max-width: 640px)" srcset="/scene-islands-sm.webp" type="image/webp" />
        <img
          src="/scene-islands.webp"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover object-center"
        />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-b from-[#080a14]/45 via-transparent to-[#080a14]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_50%_45%_at_50%_42%,rgba(10,11,14,0.66),transparent_75%)]"></div>
    </div>

    <div class="relative z-10 mx-auto flex max-w-3xl flex-col items-center gap-7 px-6 pt-32 pb-32 text-center lg:pt-44 lg:pb-44">
      <a href="/downloads" class="text-sm text-white/55 transition-colors hover:text-white/80">
        <span class="font-mono text-primary-400">{latestVersion}</span> is the latest version
      </a>

      <h1 class="text-4xl leading-tight font-semibold sm:text-5xl">
        <span class="text-primary-400">Faster</span> Minecraft server software
      </h1>

      <p class="max-w-xl text-base leading-relaxed text-white/75 [text-shadow:0_1px_12px_rgba(10,11,14,0.9)] sm:text-lg">
        Atlas Studio makes three things: a server jar, a proxy, and a regionised fork for heavy worlds.
        All free, all drop straight in, and all keep every plugin you already run — with one
        documented exception for Aurora.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 pt-1">
        <a href="/downloads" class="btn-primary px-6 py-3 text-sm">Downloads</a>
        <a
          href="https://github.com/AtlasStudioMC"
          class="btn-ghost px-6 py-3 text-sm font-medium text-white"
        >
          View on GitHub
        </a>
      </div>
    </div>
  </section>

  <section class="relative mx-auto max-w-5xl px-6 pb-24">
    <div class="surface grid overflow-hidden sm:grid-cols-3">
      <a
        href="/benchmarks"
        class="group px-6 py-9 text-center transition-colors hover:bg-white/[0.03] sm:border-r sm:border-white/[0.07]"
      >
        <div class="text-4xl font-semibold text-white">9.6%</div>
        <div class="mt-2 text-sm leading-snug text-white/55">Faster at building new parts of the world than normal Paper</div>
      </a>
      <div class="px-6 py-9 text-center sm:border-r sm:border-white/[0.07]">
        <div class="text-4xl font-semibold text-white">{releasedCount}</div>
        <div class="mt-2 text-sm leading-snug text-white/55">Minecraft versions you can pick from</div>
      </div>
      <a href="/tuning" class="group px-6 py-9 text-center transition-colors hover:bg-white/[0.03]">
        <div class="text-4xl font-semibold text-white">0</div>
        <div class="mt-2 text-sm leading-snug text-white/55">Settings we turned on without testing them first</div>
      </a>
    </div>
    <p class="mt-4 text-center text-xs text-white/40">
      See how we tested on the <a href="/benchmarks" class="text-primary-400 underline">benchmarks page</a>.
    </p>
  </section>

  <section id="products" class="relative mx-auto max-w-5xl px-6 pb-24">
    <div class="mb-12 text-center">
      <h2 class="mb-3 text-2xl font-semibold sm:text-3xl">Three things we make</h2>
      <p class="mx-auto max-w-xl text-white/55">
        Most people only need the first one.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      <div class="surface surface-hover flex flex-col p-8">
        <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2">
          <h3 class="text-xl font-semibold text-white">Atlas &amp; Astra</h3>
          <span class="pill pill-on">{latestVersion}</span>
        </div>
        <p class="mb-1 text-sm font-medium text-white/70">A server jar</p>
        <p class="mb-6 text-sm leading-relaxed text-white/50">
          This is the file your server runs on. Swap it for the one you have now and everything gets a bit
          faster — same worlds, same plugins, same settings. Astra is what 26.2 ships under; every
          older version is Atlas.
        </p>
        <div class="mt-auto flex flex-wrap items-center gap-3">
          <a href="/downloads" class="btn-primary px-5 py-2.5 text-sm">Download</a>
          <a href="/docs" class="text-sm text-white/45 underline decoration-white/20 underline-offset-4 hover:text-primary-400">
            How to set it up
          </a>
        </div>
      </div>

      <div class="surface surface-hover flex flex-col p-8">
        <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2">
          <h3 class="text-xl font-semibold text-white">Astro</h3>
          <span class="pill pill-on">build-2</span>
        </div>
        <p class="mb-1 text-sm font-medium text-white/70">A proxy</p>
        <p class="mb-6 text-sm leading-relaxed text-white/50">
          Only needed if you run more than one server. It sits in front of them and moves players between
          them, so a lobby and a survival world feel like one place. Every Velocity plugin still works.
        </p>
        <div class="mt-auto flex flex-wrap items-center gap-3">
          <a href="/downloads?t=velocity" class="btn-primary px-5 py-2.5 text-sm">
            Download
          </a>
          <a
            href="https://github.com/AtlasStudioMC/Astro"
            class="text-sm text-white/45 underline decoration-white/20 underline-offset-4 hover:text-primary-400"
          >
            Source ↗
          </a>
        </div>
      </div>

      <div class="surface surface-hover flex flex-col p-8">
        <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2">
          <h3 class="text-xl font-semibold text-white">Aurora</h3>
          <span class="pill pill-on">build 2</span>
        </div>
        <p class="mb-1 text-sm font-medium text-white/70">A regionised fork</p>
        <p class="mb-6 text-sm leading-relaxed text-white/50">
          Forked from CanvasMC/Folia. Spreads the world across CPU cores instead of one thread —
          for heavy worlds, not for most servers. Most plugins will not load on it; check yours first.
        </p>
        <div class="mt-auto flex flex-wrap items-center gap-3">
          <a href="/downloads?t=aurora" class="btn-primary px-5 py-2.5 text-sm">Download</a>
          <a
            href="https://github.com/AtlasStudioMC/Aurora"
            class="text-sm text-white/45 underline decoration-white/20 underline-offset-4 hover:text-primary-400"
          >
            Source ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="relative mx-auto max-w-6xl px-6 pb-24">
    <h2 class="mb-12 text-center text-2xl font-semibold sm:text-3xl">What you get</h2>
    <div class="grid gap-5 md:grid-cols-3">
      {
        features.map((f) => (
          <div class="surface surface-hover p-7">
            <h3 class="mb-2 text-lg font-semibold text-white">{f.title}</h3>
            <p class="text-sm leading-relaxed text-white/55">{f.body}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-center text-sm text-white/40">
      See everything we changed on the <a href="/tuning" class="text-primary-400 underline">tuning page</a>.
    </p>
  </section>

  <section id="versions" class="relative mx-auto max-w-5xl px-6 pb-24">
    <div class="mb-12 text-center">
      <h2 class="mb-3 text-2xl font-semibold sm:text-3xl">Pick your version</h2>
      <p class="mx-auto max-w-xl text-white/55">
        Newer versions are built on Leaf. Older ones use Purpur, going back to 1.20.
      </p>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      {
        forks.map((fork) => {
          const versions = VERSIONS.filter((v) => v.fork === fork);
          const shipped = versions.filter((v) => v.status === "released").length;
          return (
            <div class="surface surface-hover p-7">
              <div class="mb-1.5 flex flex-wrap items-center gap-x-3 gap-y-1">
                {FORK_INFO[fork].logo && (
                  <img src={FORK_INFO[fork].logo} alt="" width="20" height="20" class="shrink-0" />
                )}
                <h3 class="text-xl font-semibold">{fork}</h3>
                <span class="rounded-full bg-white/[0.06] px-2.5 py-0.5 font-mono text-[11px] text-white/50">
                  {shipped} versions
                </span>
                <a
                  href={FORK_INFO[fork].href}
                  class="ml-auto text-xs text-white/40 underline decoration-white/20 underline-offset-4 transition-colors hover:text-primary-400"
                >
                  GitHub ↗
                </a>
              </div>
              <p class="mb-5 text-sm leading-relaxed text-white/45">{FORK_INFO[fork].blurb}</p>
              <ul class="flex flex-wrap gap-2">
                {versions.map((v) => (
                  <li
                    class:list={["pill", v.status === "released" ? "pill-on" : "pill-off"]}
                    title={v.status === "released" ? "Ready to download" : "Not made yet"}
                  >
                    {v.version}
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
    <p class="mt-7 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-white/40">
      <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-primary-400"></span> ready to download</span>
      <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-white/20"></span> not made yet</span>
    </p>
  </section>

  <section class="relative mx-auto max-w-5xl px-6 pb-24">
    <div class="mb-10 text-center">
      <h2 class="mb-3 text-2xl font-semibold sm:text-3xl">The game this is for</h2>
      <p class="mx-auto max-w-xl text-white/55">
        Real photographs, not game screenshots — that keeps them clear to use commercially.
      </p>
    </div>
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
      {
        shots.map((s) => (
          <figure class="surface overflow-hidden">
            <img src={s.src} alt={s.alt} width="640" height="480" loading="lazy" class="aspect-4/3 w-full object-cover" />
            <figcaption class="p-3 text-[11px] leading-tight text-white/35">
              Photo by{" "}
              <a href={s.sourceUrl} rel="noopener" class="hover:text-white/70">
                {s.photographer}
              </a>{" "}
              on Unsplash
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="relative mx-auto max-w-3xl px-6 pb-24">
    <h2 class="mb-10 text-center text-2xl font-semibold sm:text-3xl">Common questions</h2>
    <div class="space-y-3">
      {
        faqs.map((f) => (
          <details class="surface group p-6 transition-colors open:bg-white/[0.04]">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-white marker:content-none">
              <span>{f.q}</span>
              <span class="shrink-0 text-lg leading-none text-primary-400 transition-transform duration-200 group-open:rotate-45">
                +
              </span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-white/60">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="relative mx-auto max-w-4xl px-6 pb-24 text-center">
    <h2 class="mb-4 text-2xl font-semibold sm:text-3xl">How many people use it</h2>
    <p class="mx-auto mb-8 max-w-xl text-white/55">
      This counts real servers running the Atlas jar. It starts at zero, like anything new does.
    </p>
    <a href="https://bstats.org/plugin/bukkit/AtlasSpigot/33733" class="surface surface-hover inline-block overflow-hidden p-3">
      <img src="https://bstats.org/signatures/bukkit/AtlasSpigot.svg" alt="Servers using Atlas" class="mx-auto rounded-lg" />
    </a>
  </section>

  <section class="relative mx-auto max-w-4xl px-6 pb-28">
    <div class="surface px-8 py-16 text-center">
      <h2 class="mb-4 text-2xl font-semibold sm:text-3xl">Ready to try it?</h2>
      <p class="mx-auto mb-8 max-w-md text-white/55">Download one file and drop it into your server folder.</p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="/downloads" class="btn-primary px-6 py-3 text-sm">Download {latestVersion}</a>
        <a href="/docs" class="btn-ghost px-6 py-3 text-sm font-medium text-white">How to set it up</a>
      </div>
    </div>
  </section>
</Layout>
