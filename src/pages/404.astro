---
import Layout from "@/layouts/Layout.astro";
// Static content, so it ships as a prerendered file served straight from the CDN edge
// rather than booting a serverless function per request. Only /downloads needs SSR (it
// reads the GitHub releases API at request time).
export const prerender = true;
---

<Layout title="Page not found" description="This page doesn't exist." noindex>
  <section class="mx-auto flex max-w-lg flex-col items-center gap-4 px-6 pt-32 pb-32 text-center">
    <img src="/logo.svg" alt="Atlas Studio" width="72" height="72" class="opacity-70" />
    <h1 class="text-block-shadow text-6xl text-primary-400">404</h1>
    <p class="text-white/60">This page doesn't exist - maybe it moved, or the link's wrong.</p>
    <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
      <a href="/" class="btn-primary px-6 py-3">
        Back home
      </a>
      <a
        href="/downloads"
        class="btn-ghost px-6 py-3"
      >
        Downloads
      </a>
    </div>
  </section>
</Layout>
